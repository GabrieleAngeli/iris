{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "build",
      "command": "dotnet",
      "type": "process",
      "args": [
        "build",
        "${workspaceFolder}/Iris.sln",
        "/property:GenerateFullPaths=true",
        "/consoleloggerparameters:NoSummary;ForceNoAlign"
      ],
      "problemMatcher": "$msCompile",
      "group": {
        "kind": "build",
        "isDefault": true
      }
    },
    {
      "label": "clean",
      "command": "dotnet",
      "type": "process",
      "args": [
        "clean",
        "${workspaceFolder}/Iris.sln"
      ],
      "problemMatcher": "$msCompile"
    },
    {
      "label": "test",
      "command": "dotnet",
      "type": "process",
      "args": [
        "test",
        "${workspaceFolder}/Iris.sln",
        "/property:GenerateFullPaths=true",
        "/consoleloggerparameters:NoSummary;ForceNoAlign"
      ],
      "problemMatcher": "$msCompile",
      "group": {
        "kind": "test",
        "isDefault": true
      }
    },
    {
      "label": "watch",
      "command": "dotnet",
      "type": "process",
      "args": [
        "watch",
        "run",
        "--project",
        "${workspaceFolder}/src/Iris.Api/Iris.Api.csproj"
      ],
      "problemMatcher": "$msCompile"
    },
    {
      "label": "build-app",
      "detail": "Build the .NET MAUI desktop client (needs: dotnet workload install maui)",
      "command": "dotnet",
      "type": "process",
      "args": [
        "build",
        "${workspaceFolder}/src/Iris.App/Iris.App.csproj",
        "-f",
        "net9.0-windows10.0.19041.0",
        "/property:GenerateFullPaths=true",
        "/consoleloggerparameters:NoSummary;ForceNoAlign"
      ],
      "problemMatcher": "$msCompile"
    },
    {
      "label": "run-api",
      "detail": "Run Iris.Api (HTTP) in the background; ready when it prints 'Now listening on'.",
      "command": "dotnet",
      "type": "process",
      "args": [
        "run",
        "--project",
        "${workspaceFolder}/src/Iris.Api/Iris.Api.csproj",
        "--launch-profile",
        "Iris.Api (HTTP)"
      ],
      "isBackground": true,
      "problemMatcher": {
        "pattern": {
          "regexp": "^__never_match__$"
        },
        "background": {
          "activeOnStart": true,
          "beginsPattern": "(Building\\.\\.\\.|Determining projects to restore)",
          "endsPattern": "(Now listening on:|Application started\\.)"
        }
      }
    },
    {
      "label": "run-app",
      "detail": "Start Iris.Api, then build and launch the .NET MAUI desktop client (Windows).",
      "command": "dotnet",
      "type": "process",
      "args": [
        "build",
        "${workspaceFolder}/src/Iris.App/Iris.App.csproj",
        "-t:Run",
        "-f",
        "net9.0-windows10.0.19041.0"
      ],
      "problemMatcher": "$msCompile",
      "dependsOn": [
        "run-api"
      ],
      "dependsOrder": "sequence"
    }
  ]
}
