{
  "Serilog": {
    "Using": [
      "Serilog.Sinks.Console",
      "Serilog.Sinks.File"
    ],
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft.AspNetCore": "Warning",
        "Microsoft.EntityFrameworkCore.Database.Command": "Warning"
      }
    },
    "WriteTo": [
      {
        "Name": "Console"
      },
      {
        "Name": "File",
        "Args": {
          "path": "logs/iris-api-.log",
          "rollingInterval": "Day",
          "retainedFileCountLimit": 14,
          "formatter": "Serilog.Formatting.Compact.CompactJsonFormatter, Serilog.Formatting.Compact"
        }
      }
    ]
  },
  "ConnectionStrings": {
    "IrisDb": "Data Source=iris.dev.db"
  },
  "Iris": {
    "Database": {
      "Provider": "Sqlite",
      "MigrateOnStartup": true,
      "SeedDemoData": false
    },
    "Auth": {
      "Mode": "Both",
      "DevHeaderName": "X-Dev-User",
      "AllowAnyEmail": false,
      "DevUsers": [
