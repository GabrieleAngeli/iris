{
  "Serilog": {
    "Using": [
      "Serilog.Sinks.Console",
      "Serilog.Sinks.File"
    ],
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft.AspNetCore": "Warning"
      }
    },
    "WriteTo": [
      {
        "Name": "Console"
      },
      {
        "Name": "File",
        "Args": {
          "path": "logs/iris-api-.log",
          "rollingInterval": "Day",
          "retainedFileCountLimit": 14,
          "formatter": "Serilog.Formatting.Compact.CompactJsonFormatter, Serilog.Formatting.Compact"
        }
      }
    ]
  },
  "AllowedHosts": "*",
  "ConnectionStrings": {
    "IrisDb": "Data Source=iris.dev.db"
  },
  "Iris": {
    "Database": {
      "Provider": "Sqlite",
      "MigrateOnStartup": true
    },
    "Auth": {
      "Mode": "",
      "DevHeaderName": "X-Dev-User",
      "AllowAnyEmail": false,
      "DevUsers": []
    },
    "Setup": {
      "AdminClaimEmails": []
    },
    "Integrations": {
      "OpenBao": {
        "Endpoint": "",
        "Token": "",
        "MountPath": "secret",
        "UseKvV2": true
      },
      "Ansible": {
        "Endpoint": "",
        "Playbook": "iris-deploy-application.yml",
        "Inventory": ""
      },
      "AWX": {
        "Endpoint": "",
        "Token": "",
        "JobTemplateId": ""
      },
      "AzureDevOps": {
        "Endpoint": ""
      },
      "Nexus": {
        "Endpoint": ""
      }
    }
  },
  "AzureAd": {
    "Instance": "https://login.microsoftonline.com/",
    "TenantId": "2a6076c5-496e-42e6-910a-f5def9e0c433",
    "ClientId": "00000000-0000-0000-0000-000000000000",
    "Audience": "api://00000000-0000-0000-0000-000000000000"
  }
}
