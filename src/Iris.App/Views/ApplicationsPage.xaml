<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    x:Class="Iris.App.Views.ApplicationsPage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:vm="clr-namespace:Iris.App.ViewModels"
    xmlns:controls="clr-namespace:Iris.App.Controls"
    x:DataType="vm:ApplicationsViewModel"
    Title="Applications">

    <Grid>
        <ScrollView>
            <VerticalStackLayout Padding="28" Spacing="18" MaximumWidthRequest="1080" HorizontalOptions="Fill">

                <Grid ColumnDefinitions="*,Auto,Auto" ColumnSpacing="10">
                    <VerticalStackLayout Spacing="4">
                        <Label Text="Applications" Style="{StaticResource TitleLarge}" />
                        <Label Text="Application inventory with repository, runtime and imported knowledge status." Style="{StaticResource Caption}" />
                    </VerticalStackLayout>
                    <Button Grid.Column="1" Text="&#xE72C;  Refresh" FontFamily="{StaticResource FontIcons}"
                            Style="{StaticResource SecondaryButton}" Command="{Binding RefreshCommand}" VerticalOptions="Start" />
                    <Button Grid.Column="2" Text="New application" Command="{Binding RequestNewApplicationCommand}"
                            IsVisible="{Binding CanManageApplications}" VerticalOptions="Start" />
                </Grid>

                <Border IsVisible="{Binding HasError}"
                        BackgroundColor="{AppThemeBinding Light=#FDE7E9, Dark=#442726}"
                        Stroke="{AppThemeBinding Light=#F1BBBB, Dark=#7A3B38}"
                        StrokeThickness="1" Padding="12,10" StrokeShape="RoundRectangle 6">
                    <Label Text="{Binding Error}" FontSize="13"
                           TextColor="{AppThemeBinding Light={StaticResource Danger}, Dark={StaticResource DangerDark}}" />
                </Border>

                <VerticalStackLayout Spacing="14" BindableLayout.ItemsSource="{Binding Applications}">
                    <BindableLayout.ItemTemplate>
                        <DataTemplate x:DataType="vm:ApplicationRowViewModel">
                            <Border Style="{StaticResource Card}">
                                <VerticalStackLayout Spacing="14">

                                    <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="12">
                                        <Border WidthRequest="38" HeightRequest="38" StrokeThickness="0" StrokeShape="RoundRectangle 19"
                                                BackgroundColor="{AppThemeBinding Light={StaticResource Secondary}, Dark={StaticResource SubtleFillDark}}">
                                            <Label Text="&#xECAA;" FontFamily="{StaticResource FontIcons}" FontSize="16"
                                                   HorizontalOptions="Center" VerticalOptions="Center"
                                                   TextColor="{AppThemeBinding Light={StaticResource AccentLight}, Dark={StaticResource AccentDark}}" />
                                        </Border>

                                        <VerticalStackLayout Grid.Column="1" Spacing="3" VerticalOptions="Center">
                                            <HorizontalStackLayout Spacing="8">
                                                <Label Text="{Binding Name}" FontFamily="{StaticResource FontSemibold}" FontSize="15"
                                                       LineBreakMode="TailTruncation" />
                                                <Border Style="{StaticResource Badge}">
                                                    <Label Text="{Binding RuntimeType}" Style="{StaticResource Caption}" />
                                                </Border>
                                                <Border Style="{StaticResource Badge}" IsVisible="{Binding IsActive, Converter={StaticResource InvertBoolConverter}}">
                                                    <Label Text="Inactive" Style="{StaticResource Caption}" />
                                                </Border>
                                            </HorizontalStackLayout>

                                            <Label Text="{Binding Slug, StringFormat='Slug: {0}'}" Style="{StaticResource Caption}" />
                                            <Label Text="{Binding RepositoryUrl}" Style="{StaticResource Caption}" LineBreakMode="TailTruncation" />
                                            <Label Text="{Binding ArtifactSummary}" Style="{StaticResource Caption}"
                                                   IsVisible="{Binding HasArtifact}" LineBreakMode="TailTruncation" />

                                            <Grid ColumnDefinitions="Auto,Auto,*" ColumnSpacing="14">
                                                <Label Text="{Binding DefaultBranch, StringFormat='Branch: {0}'}" Style="{StaticResource Caption}" />
                                                <Label Grid.Column="1" Text="{Binding VersionCountText}" Style="{StaticResource Caption}" />
                                                <Label Grid.Column="2" Text="{Binding LastImportText}" Style="{StaticResource Caption}" LineBreakMode="TailTruncation" />
                                            </Grid>
                                        </VerticalStackLayout>

                                        <HorizontalStackLayout Grid.Column="2" Spacing="8" VerticalOptions="Start">
                                            <Button Text="&#xE898;" FontFamily="{StaticResource FontIcons}"
                                                    Style="{StaticResource IconButton}"
                                                    Command="{Binding UploadManifestCommand}"
                                                    IsEnabled="{Binding IsManifestUploadBusy, Converter={StaticResource InvertBoolConverter}}"
                                                    IsVisible="{Binding CanManageApplications}"
                                                    ToolTipProperties.Text="Upload manifest for this application" />
                                            <Button Text="&#xE70F;" Style="{StaticResource IconButton}"
                                                    Command="{Binding OpenEditCommand}"
                                                    IsVisible="{Binding CanManageApplications}"
                                                    ToolTipProperties.Text="Edit application" />
                                        </HorizontalStackLayout>
                                    </Grid>

                                    <Label Text="{Binding Description}" IsVisible="{Binding HasDescription}" Style="{StaticResource Body}" />

                                    <Label Text="{Binding EditLockNotice}" IsVisible="{Binding HasEditLockNotice}"
                                           Style="{StaticResource Caption}" TextColor="{StaticResource Warning}" />

                                    <BoxView HeightRequest="1" />

                                    <Label Text="{Binding KnowledgeSummary}" Style="{StaticResource Caption}" />

                                    <VerticalStackLayout Spacing="12" IsVisible="{Binding HasManifestValidation}">
                                        <BoxView HeightRequest="1" />

                                        <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12">
                                            <VerticalStackLayout Spacing="4">
                                                <HorizontalStackLayout Spacing="8">
                                                    <Label Text="Manifest validation" Style="{StaticResource Subtitle}" />
                                                    <Border Style="{StaticResource Badge}"
                                                            BackgroundColor="{AppThemeBinding Light=#DFF6DD, Dark=#24442B}"
                                                            IsVisible="{Binding ManifestValidation.IsValid}">
                                                        <Label Text="{Binding ManifestValidation.StatusText}" Style="{StaticResource Caption}"
                                                               TextColor="{AppThemeBinding Light=#107C10, Dark=#6CCB5F}" />
                                                    </Border>
                                                    <Border Style="{StaticResource Badge}"
                                                            BackgroundColor="{AppThemeBinding Light=#FDE7E9, Dark=#442726}"
                                                            IsVisible="{Binding ManifestValidation.IsInvalid}">
                                                        <Label Text="{Binding ManifestValidation.StatusText}" Style="{StaticResource Caption}"
                                                               TextColor="{AppThemeBinding Light={StaticResource Danger}, Dark={StaticResource DangerDark}}" />
                                                    </Border>
                                                </HorizontalStackLayout>
                                                <Label Text="{Binding ManifestValidation.TargetText}" Style="{StaticResource Caption}" />
                                                <Label Text="{Binding ManifestValidation.FileName}" Style="{StaticResource Body}" LineBreakMode="TailTruncation" />
                                                <Label Text="{Binding ManifestValidation.SchemaVersion, StringFormat='Schema version: {0}'}" Style="{StaticResource Caption}" />
                                            </VerticalStackLayout>

                                            <Button Grid.Column="1" Text="&#xE711;" FontFamily="{StaticResource FontIcons}"
                                                    Style="{StaticResource IconButton}" Command="{Binding ClearManifestValidationCommand}"
                                                    ToolTipProperties.Text="Clear validation" />
                                        </Grid>

                                        <Grid ColumnDefinitions="*,*,*" ColumnSpacing="10">
                                            <Border BackgroundColor="{AppThemeBinding Light={StaticResource LayerAltLight}, Dark={StaticResource LayerAltDark}}"
                                                    Stroke="{AppThemeBinding Light={StaticResource StrokeLight}, Dark={StaticResource StrokeDark}}"
                                                    StrokeThickness="1" Padding="10" StrokeShape="RoundRectangle 6">
                                                <VerticalStackLayout Spacing="4">
                                                    <Label Text="Contract" Style="{StaticResource Caption}" />
                                                    <Label Text="{Binding ManifestValidation.Summary}" Style="{StaticResource Body}" />
                                                </VerticalStackLayout>
                                            </Border>
                                            <Border Grid.Column="1"
                                                    BackgroundColor="{AppThemeBinding Light={StaticResource LayerAltLight}, Dark={StaticResource LayerAltDark}}"
                                                    Stroke="{AppThemeBinding Light={StaticResource StrokeLight}, Dark={StaticResource StrokeDark}}"
                                                    StrokeThickness="1" Padding="10" StrokeShape="RoundRectangle 6">
                                                <VerticalStackLayout Spacing="4">
                                                    <Label Text="Types" Style="{StaticResource Caption}" />
                                                    <Label Text="{Binding ManifestValidation.TypeSummary}" Style="{StaticResource Body}" />
                                                </VerticalStackLayout>
                                            </Border>
                                            <Border Grid.Column="2"
                                                    BackgroundColor="{AppThemeBinding Light={StaticResource LayerAltLight}, Dark={StaticResource LayerAltDark}}"
                                                    Stroke="{AppThemeBinding Light={StaticResource StrokeLight}, Dark={StaticResource StrokeDark}}"
                                                    StrokeThickness="1" Padding="10" StrokeShape="RoundRectangle 6">
                                                <VerticalStackLayout Spacing="4">
                                                    <Label Text="Application links" Style="{StaticResource Caption}" />
                                                    <Label Text="{Binding ManifestValidation.LinkSummary}" Style="{StaticResource Body}" />
                                                </VerticalStackLayout>
                                            </Border>
                                        </Grid>

                                        <VerticalStackLayout Spacing="12" IsVisible="{Binding ManifestValidation.HasAssimilationPreview}">
                                            <VerticalStackLayout Spacing="3">
                                                <Label Text="Assimilation preview" Style="{StaticResource Subtitle}" />
                                                <Label Text="{Binding ManifestValidation.PreviewSummary}" Style="{StaticResource Caption}" />
                                                <Label Text="{Binding ManifestValidation.DecisionSummary}" Style="{StaticResource Caption}" />
                                            </VerticalStackLayout>

                                            <HorizontalStackLayout Spacing="8">
                                                <Button Text="Start import"
                                                        Command="{Binding RequestManifestImportCommand}"
                                                        IsVisible="{Binding CanStartManifestImport}" />
                                                <Label Text="Creates a version and imports the supported package fields."
                                                       Style="{StaticResource Caption}" VerticalOptions="Center" />
                                            </HorizontalStackLayout>

                                            <Grid ColumnDefinitions="*,*" ColumnSpacing="10" RowDefinitions="Auto,Auto,Auto,Auto">
                                                <Border IsVisible="{Binding ManifestValidation.HasConfigurationKeyPreview}"
                                                        BackgroundColor="{AppThemeBinding Light={StaticResource LayerAltLight}, Dark={StaticResource LayerAltDark}}"
                                                        Stroke="{AppThemeBinding Light={StaticResource StrokeLight}, Dark={StaticResource StrokeDark}}"
                                                        StrokeThickness="1" Padding="12" StrokeShape="RoundRectangle 6">
                                                    <VerticalStackLayout Spacing="10">
                                                        <Label Text="Configuration keys" FontFamily="{StaticResource FontSemibold}" FontSize="13" />
                                                        <VerticalStackLayout Spacing="8"
                                                                             BindableLayout.ItemsSource="{Binding ManifestValidation.ConfigurationKeyPreview}">
                                                            <BindableLayout.ItemTemplate>
                                                                <DataTemplate x:DataType="vm:ManifestPreviewItemViewModel">
                                                                    <Grid ColumnDefinitions="*,Auto" RowDefinitions="Auto,Auto,Auto,Auto" ColumnSpacing="8">
                                                                        <Label Text="{Binding Title}" FontFamily="{StaticResource FontSemibold}" FontSize="12"
                                                                               LineBreakMode="TailTruncation" />
                                                                        <Border Grid.Column="1" Style="{StaticResource Badge}" IsVisible="{Binding RequiresDecision}"
                                                                                BackgroundColor="{AppThemeBinding Light=#FFF4CE, Dark=#4A3A1C}">
                                                                            <Label Text="Decision" Style="{StaticResource Caption}" TextColor="{StaticResource Warning}" />
                                                                        </Border>
                                                                        <Label Grid.Row="1" Grid.ColumnSpan="2" Text="{Binding Subtitle}" Style="{StaticResource Caption}" />
                                                                        <Label Grid.Row="2" Grid.ColumnSpan="2" Text="{Binding Detail}" Style="{StaticResource Caption}"
                                                                               IsVisible="{Binding HasDetail}" />
                                                                        <Label Grid.Row="3" Grid.ColumnSpan="2" Text="{Binding DecisionText}" Style="{StaticResource Caption}"
                                                                               TextColor="{StaticResource Warning}" IsVisible="{Binding HasDecisionText}" />
                                                                    </Grid>
                                                                </DataTemplate>
                                                            </BindableLayout.ItemTemplate>
                                                        </VerticalStackLayout>
                                                    </VerticalStackLayout>
                                                </Border>

                                                <Border Grid.Column="1" IsVisible="{Binding ManifestValidation.HasDependencyPreview}"
                                                        BackgroundColor="{AppThemeBinding Light={StaticResource LayerAltLight}, Dark={StaticResource LayerAltDark}}"
                                                        Stroke="{AppThemeBinding Light={StaticResource StrokeLight}, Dark={StaticResource StrokeDark}}"
                                                        StrokeThickness="1" Padding="12" StrokeShape="RoundRectangle 6">
                                                    <VerticalStackLayout Spacing="10">
                                                        <Label Text="Dependencies" FontFamily="{StaticResource FontSemibold}" FontSize="13" />
                                                        <VerticalStackLayout Spacing="8"
                                                                             BindableLayout.ItemsSource="{Binding ManifestValidation.DependencyPreview}">
                                                            <BindableLayout.ItemTemplate>
                                                                <DataTemplate x:DataType="vm:ManifestPreviewItemViewModel">
                                                                    <Grid ColumnDefinitions="*,Auto" RowDefinitions="Auto,Auto,Auto,Auto" ColumnSpacing="8">
                                                                        <Label Text="{Binding Title}" FontFamily="{StaticResource FontSemibold}" FontSize="12"
                                                                               LineBreakMode="TailTruncation" />
                                                                        <Border Grid.Column="1" Style="{StaticResource Badge}" IsVisible="{Binding RequiresDecision}"
                                                                                BackgroundColor="{AppThemeBinding Light=#FFF4CE, Dark=#4A3A1C}">
                                                                            <Label Text="Decision" Style="{StaticResource Caption}" TextColor="{StaticResource Warning}" />
                                                                        </Border>
                                                                        <Label Grid.Row="1" Grid.ColumnSpan="2" Text="{Binding Subtitle}" Style="{StaticResource Caption}" />
                                                                        <Label Grid.Row="2" Grid.ColumnSpan="2" Text="{Binding Detail}" Style="{StaticResource Caption}"
                                                                               IsVisible="{Binding HasDetail}" />
                                                                        <Label Grid.Row="3" Grid.ColumnSpan="2" Text="{Binding DecisionText}" Style="{StaticResource Caption}"
                                                                               TextColor="{StaticResource Warning}" IsVisible="{Binding HasDecisionText}" />
                                                                    </Grid>
                                                                </DataTemplate>
                                                            </BindableLayout.ItemTemplate>
                                                        </VerticalStackLayout>
                                                    </VerticalStackLayout>
                                                </Border>

                                                <Border Grid.Row="1" IsVisible="{Binding ManifestValidation.HasPlaceholderPreview}"
                                                        BackgroundColor="{AppThemeBinding Light={StaticResource LayerAltLight}, Dark={StaticResource LayerAltDark}}"
                                                        Stroke="{AppThemeBinding Light={StaticResource StrokeLight}, Dark={StaticResource StrokeDark}}"
                                                        StrokeThickness="1" Padding="12" StrokeShape="RoundRectangle 6">
                                                    <VerticalStackLayout Spacing="10">
                                                        <Label Text="Exposed placeholders" FontFamily="{StaticResource FontSemibold}" FontSize="13" />
                                                        <VerticalStackLayout Spacing="8"
                                                                             BindableLayout.ItemsSource="{Binding ManifestValidation.PlaceholderPreview}">
                                                            <BindableLayout.ItemTemplate>
                                                                <DataTemplate x:DataType="vm:ManifestPreviewItemViewModel">
                                                                    <Grid RowDefinitions="Auto,Auto,Auto" RowSpacing="2">
                                                                        <Label Text="{Binding Title}" FontFamily="{StaticResource FontSemibold}" FontSize="12"
                                                                               LineBreakMode="TailTruncation" />
                                                                        <Label Grid.Row="1" Text="{Binding Subtitle}" Style="{StaticResource Caption}" />
                                                                        <Label Grid.Row="2" Text="{Binding Detail}" Style="{StaticResource Caption}"
                                                                               IsVisible="{Binding HasDetail}" />
                                                                    </Grid>
                                                                </DataTemplate>
                                                            </BindableLayout.ItemTemplate>
                                                        </VerticalStackLayout>
                                                    </VerticalStackLayout>
                                                </Border>

                                                <Border Grid.Row="1" Grid.Column="1" IsVisible="{Binding ManifestValidation.HasProfilePreview}"
                                                        BackgroundColor="{AppThemeBinding Light={StaticResource LayerAltLight}, Dark={StaticResource LayerAltDark}}"
                                                        Stroke="{AppThemeBinding Light={StaticResource StrokeLight}, Dark={StaticResource StrokeDark}}"
                                                        StrokeThickness="1" Padding="12" StrokeShape="RoundRectangle 6">
                                                    <VerticalStackLayout Spacing="10">
                                                        <Label Text="Profiles" FontFamily="{StaticResource FontSemibold}" FontSize="13" />
                                                        <VerticalStackLayout Spacing="8"
                                                                             BindableLayout.ItemsSource="{Binding ManifestValidation.ProfilePreview}">
                                                            <BindableLayout.ItemTemplate>
                                                                <DataTemplate x:DataType="vm:ManifestPreviewItemViewModel">
                                                                    <Grid ColumnDefinitions="*,Auto" RowDefinitions="Auto,Auto,Auto,Auto" ColumnSpacing="8">
                                                                        <Label Text="{Binding Title}" FontFamily="{StaticResource FontSemibold}" FontSize="12"
                                                                               LineBreakMode="TailTruncation" />
                                                                        <Border Grid.Column="1" Style="{StaticResource Badge}" IsVisible="{Binding RequiresDecision}"
                                                                                BackgroundColor="{AppThemeBinding Light=#FFF4CE, Dark=#4A3A1C}">
                                                                            <Label Text="Decision" Style="{StaticResource Caption}" TextColor="{StaticResource Warning}" />
                                                                        </Border>
                                                                        <Label Grid.Row="1" Grid.ColumnSpan="2" Text="{Binding Subtitle}" Style="{StaticResource Caption}" />
                                                                        <Label Grid.Row="2" Grid.ColumnSpan="2" Text="{Binding Detail}" Style="{StaticResource Caption}"
                                                                               IsVisible="{Binding HasDetail}" />
                                                                        <Label Grid.Row="3" Grid.ColumnSpan="2" Text="{Binding DecisionText}" Style="{StaticResource Caption}"
                                                                               TextColor="{StaticResource Warning}" IsVisible="{Binding HasDecisionText}" />
                                                                    </Grid>
                                                                </DataTemplate>
                                                            </BindableLayout.ItemTemplate>
                                                        </VerticalStackLayout>
                                                    </VerticalStackLayout>
                                                </Border>

                                                <Border Grid.Row="2" Grid.ColumnSpan="2" IsVisible="{Binding ManifestValidation.HasApplicationUnitPreview}"
                                                        BackgroundColor="{AppThemeBinding Light={StaticResource LayerAltLight}, Dark={StaticResource LayerAltDark}}"
                                                        Stroke="{AppThemeBinding Light={StaticResource StrokeLight}, Dark={StaticResource StrokeDark}}"
                                                        StrokeThickness="1" Padding="12" StrokeShape="RoundRectangle 6">
                                                    <VerticalStackLayout Spacing="10">
                                                        <Label Text="Launchable application units" FontFamily="{StaticResource FontSemibold}" FontSize="13" />
                                                        <VerticalStackLayout Spacing="8"
                                                                             BindableLayout.ItemsSource="{Binding ManifestValidation.ApplicationUnitPreview}">
                                                            <BindableLayout.ItemTemplate>
                                                                <DataTemplate x:DataType="vm:ManifestPreviewItemViewModel">
                                                                    <Grid ColumnDefinitions="*,Auto" RowDefinitions="Auto,Auto,Auto,Auto" ColumnSpacing="8">
                                                                        <Label Text="{Binding Title}" FontFamily="{StaticResource FontSemibold}" FontSize="12"
                                                                               LineBreakMode="TailTruncation" />
                                                                        <Border Grid.Column="1" Style="{StaticResource Badge}" IsVisible="{Binding RequiresDecision}"
                                                                                BackgroundColor="{AppThemeBinding Light=#FFF4CE, Dark=#4A3A1C}">
                                                                            <Label Text="Model gap" Style="{StaticResource Caption}" TextColor="{StaticResource Warning}" />
                                                                        </Border>
                                                                        <Label Grid.Row="1" Grid.ColumnSpan="2" Text="{Binding Subtitle}" Style="{StaticResource Caption}" />
                                                                        <Label Grid.Row="2" Grid.ColumnSpan="2" Text="{Binding Detail}" Style="{StaticResource Caption}"
                                                                               IsVisible="{Binding HasDetail}" />
                                                                        <Label Grid.Row="3" Grid.ColumnSpan="2" Text="{Binding DecisionText}" Style="{StaticResource Caption}"
                                                                               TextColor="{StaticResource Warning}" IsVisible="{Binding HasDecisionText}" />
                                                                    </Grid>
                                                                </DataTemplate>
                                                            </BindableLayout.ItemTemplate>
                                                        </VerticalStackLayout>
                                                    </VerticalStackLayout>
                                                </Border>

                                                <Border Grid.Row="3" Grid.ColumnSpan="2" IsVisible="{Binding ManifestValidation.HasAssimilationDecisions}"
                                                        BackgroundColor="{AppThemeBinding Light=#FFF8E1, Dark=#332B18}"
                                                        Stroke="{AppThemeBinding Light=#E4C35A, Dark=#8A7130}"
                                                        StrokeThickness="1" Padding="12" StrokeShape="RoundRectangle 6">
                                                    <VerticalStackLayout Spacing="10">
                                                        <Label Text="Decisions before import/binding" FontFamily="{StaticResource FontSemibold}" FontSize="13" />
                                                        <VerticalStackLayout Spacing="8"
                                                                             BindableLayout.ItemsSource="{Binding ManifestValidation.AssimilationDecisions}">
                                                            <BindableLayout.ItemTemplate>
                                                                <DataTemplate x:DataType="vm:ManifestPreviewItemViewModel">
                                                                    <Grid RowDefinitions="Auto,Auto,Auto" RowSpacing="2">
                                                                        <Label Text="{Binding Title}" FontFamily="{StaticResource FontSemibold}" FontSize="12"
                                                                               LineBreakMode="TailTruncation" />
                                                                        <Label Grid.Row="1" Text="{Binding Subtitle}" Style="{StaticResource Caption}" />
                                                                        <Label Grid.Row="2" Text="{Binding Detail}" Style="{StaticResource Caption}"
                                                                               IsVisible="{Binding HasDetail}" />
                                                                    </Grid>
                                                                </DataTemplate>
                                                            </BindableLayout.ItemTemplate>
                                                        </VerticalStackLayout>
                                                    </VerticalStackLayout>
                                                </Border>
                                            </Grid>
                                        </VerticalStackLayout>

                                        <Border IsVisible="{Binding ManifestValidation.HasIssues}"
                                                BackgroundColor="{AppThemeBinding Light={StaticResource LayerAltLight}, Dark={StaticResource LayerAltDark}}"
                                                Stroke="{AppThemeBinding Light={StaticResource StrokeLight}, Dark={StaticResource StrokeDark}}"
                                                StrokeThickness="1"
                                                Padding="12"
                                                StrokeShape="RoundRectangle 6">
                                            <VerticalStackLayout Spacing="8"
                                                                 BindableLayout.ItemsSource="{Binding ManifestValidation.Issues}">
                                                <BindableLayout.ItemTemplate>
                                                    <DataTemplate x:DataType="vm:ManifestValidationIssueViewModel">
                                                        <Grid ColumnDefinitions="88,*" ColumnSpacing="10">
                                                            <Border Style="{StaticResource Badge}"
                                                                    BackgroundColor="{AppThemeBinding Light=#FDE7E9, Dark=#442726}"
                                                                    IsVisible="{Binding IsError}">
                                                                <Label Text="Error" Style="{StaticResource Caption}"
                                                                       TextColor="{AppThemeBinding Light={StaticResource Danger}, Dark={StaticResource DangerDark}}" />
                                                            </Border>
                                                            <Border Style="{StaticResource Badge}"
                                                                    BackgroundColor="{AppThemeBinding Light=#FFF4CE, Dark=#4A3A1C}"
                                                                    IsVisible="{Binding IsWarning}">
                                                                <Label Text="Warning" Style="{StaticResource Caption}"
                                                                       TextColor="{StaticResource Warning}" />
                                                            </Border>
                                                            <Border Style="{StaticResource Badge}"
                                                                    BackgroundColor="{AppThemeBinding Light={StaticResource Secondary}, Dark={StaticResource SubtleFillDark}}"
                                                                    IsVisible="{Binding IsInfo}">
                                                                <Label Text="Info" Style="{StaticResource Caption}" />
                                                            </Border>
                                                            <Label Grid.Column="1" Text="{Binding Message}" Style="{StaticResource Body}" />
                                                        </Grid>
                                                    </DataTemplate>
                                                </BindableLayout.ItemTemplate>
                                            </VerticalStackLayout>
                                        </Border>
                                    </VerticalStackLayout>

                                </VerticalStackLayout>
                            </Border>
                        </DataTemplate>
                    </BindableLayout.ItemTemplate>
                </VerticalStackLayout>

            </VerticalStackLayout>
        </ScrollView>

        <controls:LoadingView IsActive="{Binding IsLoading}" Message="Loading applications..." />
    </Grid>

</ContentPage>
