<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    x:Class="Iris.App.Views.ExtractorGuidePage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:controls="clr-namespace:Iris.App.Controls"
    xmlns:vm="clr-namespace:Iris.App.ViewModels"
    x:DataType="vm:ExtractorGuideViewModel"
    Title="Extractor guide">

    <ScrollView>
        <VerticalStackLayout Padding="28" Spacing="18" MaximumWidthRequest="1120" HorizontalOptions="Fill">

            <VerticalStackLayout Spacing="4">
                <Label Text="Extractor guide" Style="{StaticResource TitleLarge}" />
                <Label Text="Each technology exposes the same two paths: automatic extraction and manual manifest composition."
                       Style="{StaticResource Caption}" />
            </VerticalStackLayout>

            <controls:TabGroup
                Title="Shared Iris manifest contract"
                ItemsSource="{Binding SharedManifestTabs}" />

            <VerticalStackLayout Spacing="18" BindableLayout.ItemsSource="{Binding TechnologyGuides}">
                <BindableLayout.ItemTemplate>
                    <DataTemplate x:DataType="vm:ExtractorTechnologyGuide">
                        <controls:TabGroup
                            Title="{Binding Title}"
                            ItemsSource="{Binding Tabs}"
                            SelectedIndex="{Binding SelectedIndex}" />
                    </DataTemplate>
                </BindableLayout.ItemTemplate>
            </VerticalStackLayout>

        </VerticalStackLayout>
    </ScrollView>
</ContentPage>
