<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    x:Class="Iris.App.Views.StartupPage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:vm="clr-namespace:Iris.App.ViewModels"
    x:DataType="vm:StartupViewModel"
    Shell.NavBarIsVisible="False"
    Title="Iris">

    <Grid BackgroundColor="{AppThemeBinding Light={StaticResource AccentLight}, Dark={StaticResource AppBackgroundDark}}">
        <VerticalStackLayout Spacing="18"
                             HorizontalOptions="Center"
                             VerticalOptions="Center">
            <Border WidthRequest="112" HeightRequest="112" StrokeThickness="0"
                    BackgroundColor="#F4F0E6" StrokeShape="RoundRectangle 56">
                <Image Source="iris_mark.png" WidthRequest="84" HeightRequest="84"
                       HorizontalOptions="Center" VerticalOptions="Center" />
            </Border>

            <VerticalStackLayout Spacing="4" HorizontalOptions="Center">
                <Label Text="Iris" TextColor="White" FontFamily="{StaticResource FontDisplay}"
                       FontSize="34" HorizontalTextAlignment="Center" />
                <Label Text="{Binding StatusMessage}" TextColor="#DCEBFF"
                       FontSize="13" HorizontalTextAlignment="Center" />
            </VerticalStackLayout>

            <ActivityIndicator IsRunning="True" Color="White"
                               WidthRequest="28" HeightRequest="28"
                               HorizontalOptions="Center" />

            <Label Text="{Binding ErrorMessage}" IsVisible="{Binding HasError}"
                   TextColor="#FFE2E5" FontSize="12"
                   HorizontalTextAlignment="Center" MaximumWidthRequest="320" />
        </VerticalStackLayout>
    </Grid>
</ContentPage>
