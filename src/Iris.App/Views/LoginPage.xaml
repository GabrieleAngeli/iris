<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    x:Class="Iris.App.Views.LoginPage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:vm="clr-namespace:Iris.App.ViewModels"
    x:DataType="vm:LoginViewModel"
    Shell.NavBarIsVisible="False"
    Title="Sign in">

    <Grid ColumnDefinitions="1.1*,1*">

        <!-- ===================== Brand panel ===================== -->
        <Grid Padding="56" RowDefinitions="Auto,*,Auto">
            <Grid.Background>
                <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                    <GradientStop Offset="0.0" Color="{AppThemeBinding Light=#0F6CBD, Dark=#0B3B66}" />
                    <GradientStop Offset="1.0" Color="{AppThemeBinding Light=#2886DE, Dark=#0E4775}" />
                </LinearGradientBrush>
            </Grid.Background>

            <HorizontalStackLayout Spacing="12">
                <Border WidthRequest="48" HeightRequest="48" StrokeThickness="0"
                        BackgroundColor="#F4F0E6" StrokeShape="RoundRectangle 24">
                    <Image Source="iris_mark.png" WidthRequest="36" HeightRequest="36"
                           HorizontalOptions="Center" VerticalOptions="Center" />
                </Border>
                <VerticalStackLayout Spacing="0" VerticalOptions="Center">
                    <Label Text="Iris" TextColor="White" FontFamily="{StaticResource FontSemibold}" FontSize="19" />
                    <Label Text="ICP" TextColor="#DCEBFF" FontSize="12" />
                </VerticalStackLayout>
            </HorizontalStackLayout>

            <VerticalStackLayout Grid.Row="1" Spacing="18" VerticalOptions="Center">
                <Image Source="iris_mark_light.png" HeightRequest="128" HorizontalOptions="Start"
                       Margin="0,0,0,6" />
                <Label Text="Infrastructure Control Plane"
                       TextColor="White" FontFamily="{StaticResource FontDisplay}" FontSize="40" LineHeight="1.15" />
                <Label Text="Iris holds the desired state of your infrastructure, application configuration and deployments across every customer and environment. It defines, validates and orchestrates — Ansible, AWX and OpenBao execute."
                       TextColor="#DCEBFF" FontSize="16" MaximumWidthRequest="480" />
                <HorizontalStackLayout Spacing="24" Margin="0,12,0,0">
                    <VerticalStackLayout>
                        <Label Text="Multi-customer" TextColor="White" FontFamily="{StaticResource FontSemibold}" FontSize="18" />
                        <Label Text="isolation" TextColor="#DCEBFF" FontSize="13" />
                    </VerticalStackLayout>
                    <VerticalStackLayout>
                        <Label Text="Capillary" TextColor="White" FontFamily="{StaticResource FontSemibold}" FontSize="18" />
                        <Label Text="RBAC + SSO" TextColor="#DCEBFF" FontSize="13" />
                    </VerticalStackLayout>
                    <VerticalStackLayout>
                        <Label Text="Validated" TextColor="White" FontFamily="{StaticResource FontSemibold}" FontSize="18" />
                        <Label Text="deployments" TextColor="#DCEBFF" FontSize="13" />
                    </VerticalStackLayout>
                </HorizontalStackLayout>
            </VerticalStackLayout>

            <Label Grid.Row="2" Text="© 2026 Gabriele Angeli · Iris ICP"
                   TextColor="#BBD7F5" FontSize="12" />
        </Grid>

        <!-- ===================== Login form ===================== -->
        <ScrollView Grid.Column="1"
                    BackgroundColor="{AppThemeBinding Light={StaticResource AppBackgroundLight}, Dark={StaticResource AppBackgroundDark}}">
            <Grid Padding="40" RowDefinitions="*,Auto,*">

                <VerticalStackLayout Grid.Row="1" Spacing="18" MaximumWidthRequest="380"
                                     HorizontalOptions="Center" VerticalOptions="Center">

                    <VerticalStackLayout Spacing="4">
                        <Label Text="Sign in" Style="{StaticResource TitleLarge}" />
                        <Label Text="Use your Iris account to continue." Style="{StaticResource Caption}" />
                    </VerticalStackLayout>

                    <!-- Error infobar -->
                    <Border IsVisible="{Binding HasError}"
                            BackgroundColor="{AppThemeBinding Light=#FDE7E9, Dark=#442726}"
                            Stroke="{AppThemeBinding Light=#F1BBBB, Dark=#7A3B38}"
                            StrokeThickness="1" Padding="12,10" StrokeShape="RoundRectangle 6">
                        <HorizontalStackLayout Spacing="10">
                            <Label Text="&#xE783;" FontFamily="{StaticResource FontIcons}" FontSize="16"
                                   TextColor="{AppThemeBinding Light={StaticResource Danger}, Dark={StaticResource DangerDark}}"
                                   VerticalOptions="Center" />
                            <Label Text="{Binding ErrorMessage}" FontSize="13"
                                   TextColor="{AppThemeBinding Light={StaticResource Danger}, Dark={StaticResource DangerDark}}"
                                   VerticalOptions="Center" />
                        </HorizontalStackLayout>
                    </Border>

                    <!-- Username -->
                    <VerticalStackLayout Spacing="6">
                        <Label Text="User name or email" Style="{StaticResource Caption}" />
                        <Border Style="{StaticResource FieldBorder}">
                            <Grid ColumnDefinitions="Auto,*" ColumnSpacing="10">
                                <Label Text="&#xE77B;" FontFamily="{StaticResource FontIcons}" FontSize="16"
                                       VerticalOptions="Center"
                                       TextColor="{AppThemeBinding Light={StaticResource TextSecondaryLight}, Dark={StaticResource TextSecondaryDark}}" />
                                <Entry Grid.Column="1" Text="{Binding Username}" Placeholder="you@company.com"
                                       ReturnType="Next" />
                            </Grid>
                        </Border>
                    </VerticalStackLayout>

                    <!-- Password -->
                    <VerticalStackLayout Spacing="6">
                        <Label Text="Password" Style="{StaticResource Caption}" />
                        <Border Style="{StaticResource FieldBorder}">
                            <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="10">
                                <Label Text="&#xE72E;" FontFamily="{StaticResource FontIcons}" FontSize="16"
                                       VerticalOptions="Center"
                                       TextColor="{AppThemeBinding Light={StaticResource TextSecondaryLight}, Dark={StaticResource TextSecondaryDark}}" />
                                <Entry Grid.Column="1" Text="{Binding Password}" Placeholder="Enter your password"
                                       IsPassword="{Binding IsPasswordHidden}" ReturnType="Go"
                                       ReturnCommand="{Binding SignInCommand}" />
                                <Button Grid.Column="2" Style="{StaticResource LinkButton}"
                                        Padding="0" MinimumWidthRequest="32"
                                        Text="{Binding IsPasswordHidden, Converter={StaticResource RevealConverter}}"
                                        FontFamily="{StaticResource FontIcons}" FontSize="16"
                                        Command="{Binding TogglePasswordVisibilityCommand}" />
                            </Grid>
                        </Border>
                    </VerticalStackLayout>

                    <!-- Options row -->
                    <Grid ColumnDefinitions="*,Auto">
                        <HorizontalStackLayout Spacing="6" VerticalOptions="Center">
                            <CheckBox IsChecked="{Binding RememberMe}" VerticalOptions="Center" />
                            <Label Text="Remember me" Style="{StaticResource Body}" VerticalOptions="Center" />
                        </HorizontalStackLayout>
                        <Button Grid.Column="1" Text="Forgot password?" Style="{StaticResource LinkButton}"
                                Command="{Binding ForgotPasswordCommand}" />
                    </Grid>

                    <!-- Submit -->
                    <Grid>
                        <Button Text="Sign in" Command="{Binding SignInCommand}"
                                IsVisible="{Binding IsBusy, Converter={StaticResource InvertBoolConverter}}"
                                HorizontalOptions="Fill" />
                        <Border IsVisible="{Binding IsBusy}"
                                BackgroundColor="{AppThemeBinding Light={StaticResource AccentLight}, Dark={StaticResource AccentDark}}"
                                StrokeThickness="0" StrokeShape="RoundRectangle 6" MinimumHeightRequest="40">
                            <ActivityIndicator IsRunning="{Binding IsBusy}" Color="White"
                                               HeightRequest="22" WidthRequest="22"
                                               HorizontalOptions="Center" VerticalOptions="Center" />
                        </Border>
                    </Grid>

                    <!-- Divider -->
                    <Grid ColumnDefinitions="*,Auto,*" ColumnSpacing="12" Margin="0,2">
                        <BoxView HeightRequest="1" VerticalOptions="Center" />
                        <Label Grid.Column="1" Text="or" Style="{StaticResource Caption}" />
                        <BoxView Grid.Column="2" HeightRequest="1" VerticalOptions="Center" />
                    </Grid>

                    <Button Text="Continue with single sign-on" Style="{StaticResource SecondaryButton}"
                            Command="{Binding UseSsoCommand}" HorizontalOptions="Fill" />

                    <Label HorizontalOptions="Center" Style="{StaticResource Caption}">
                        <Label.FormattedText>
                            <FormattedString>
                                <Span Text="First time here? " />
                                <Span Text="Set your password from an invitation" TextDecorations="Underline">
                                    <Span.GestureRecognizers>
                                        <TapGestureRecognizer Command="{Binding RequestAcceptInvitationCommand}" />
                                    </Span.GestureRecognizers>
                                </Span>
                            </FormattedString>
                        </Label.FormattedText>
                    </Label>

                </VerticalStackLayout>
            </Grid>
        </ScrollView>
    </Grid>

</ContentPage>
