<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    x:Class="Iris.App.Views.SetupWizardPage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:vm="clr-namespace:Iris.App.ViewModels"
    x:DataType="vm:SetupWizardViewModel"
    Shell.FlyoutBehavior="Disabled"
    Shell.NavBarIsVisible="False"
    Title="Set up Iris"
    BackgroundColor="{AppThemeBinding Light={StaticResource AppBackgroundLight}, Dark={StaticResource AppBackgroundDark}}">

    <ScrollView>
        <Grid Padding="24">
            <Border Style="{StaticResource Card}" MaximumWidthRequest="480" WidthRequest="480"
                    HorizontalOptions="Center" VerticalOptions="Center">
                <VerticalStackLayout Padding="8" Spacing="14">

                    <VerticalStackLayout Spacing="4">
                        <Label Text="Welcome to Iris" Style="{StaticResource TitleLarge}" />
                        <Label Style="{StaticResource Caption}">
                            <Label.FormattedText>
                                <FormattedString>
                                    <Span Text="Step " />
                                    <Span Text="{Binding CurrentStep}" />
                                    <Span Text=" of 4 — " />
                                    <Span Text="OpenBao" />
                                    <Span Text=", " />
                                    <Span Text="AWX" />
                                    <Span Text=", " />
                                    <Span Text="mail relay" />
                                    <Span Text=", then " />
                                    <Span Text="your administrator account" />
                                </FormattedString>
                            </Label.FormattedText>
                        </Label>
                    </VerticalStackLayout>

                    <!-- ===== Step 1: OpenBao ===== -->
                    <VerticalStackLayout Spacing="12" IsVisible="{Binding IsOpenBaoStep}">
                        <Label Style="{StaticResource Body}"
                               Text="Iris stores secrets (SMTP password, integration tokens, credentials) in OpenBao, never in its own database. Do you already have an OpenBao instance?" />

                        <VerticalStackLayout Spacing="4">
                            <Label Text="What should Iris do?" Style="{StaticResource Caption}" />
                            <Border Style="{StaticResource FieldBorder}">
                                <Picker ItemsSource="{Binding IntegrationModeOptions}" SelectedIndex="{Binding OpenBaoModeIndex}" />
                            </Border>
                        </VerticalStackLayout>

                        <Grid ColumnDefinitions="2*,1*" ColumnSpacing="10" IsVisible="{Binding IsOpenBaoUseExisting}">
                            <VerticalStackLayout Spacing="4">
                                <Label Text="Endpoint" Style="{StaticResource Caption}" />
                                <Border Style="{StaticResource FieldBorder}">
                                    <Entry Text="{Binding OpenBaoEndpoint}" Placeholder="https://openbao.internal:8200" />
                                </Border>
                            </VerticalStackLayout>
                            <VerticalStackLayout Grid.Column="1" Spacing="4">
                                <Label Text="Token" Style="{StaticResource Caption}" />
                                <Border Style="{StaticResource FieldBorder}">
                                    <Entry Text="{Binding OpenBaoToken}" IsPassword="True" />
                                </Border>
                            </VerticalStackLayout>
                        </Grid>

                        <Label Text="{Binding OpenBaoError}" IsVisible="{Binding HasOpenBaoError}" FontSize="12"
                               TextColor="{AppThemeBinding Light={StaticResource Danger}, Dark={StaticResource DangerDark}}" />

                        <Button Text="Next" Command="{Binding GoToAwxStepCommand}" HorizontalOptions="Fill" Margin="0,4,0,0" />
                    </VerticalStackLayout>

                    <!-- ===== Step 2: AWX ===== -->
                    <VerticalStackLayout Spacing="12" IsVisible="{Binding IsAwxStep}">
                        <Label Style="{StaticResource Body}"
                               Text="AWX runs the Ansible jobs Iris prepares for deployments. Do you already have an AWX instance?" />

                        <VerticalStackLayout Spacing="4">
                            <Label Text="What should Iris do?" Style="{StaticResource Caption}" />
                            <Border Style="{StaticResource FieldBorder}">
                                <Picker ItemsSource="{Binding IntegrationModeOptions}" SelectedIndex="{Binding AwxModeIndex}" />
                            </Border>
                        </VerticalStackLayout>

                        <Grid ColumnDefinitions="2*,1*,1*" ColumnSpacing="10" IsVisible="{Binding IsAwxUseExisting}">
                            <VerticalStackLayout Spacing="4">
                                <Label Text="Endpoint" Style="{StaticResource Caption}" />
                                <Border Style="{StaticResource FieldBorder}">
                                    <Entry Text="{Binding AwxEndpoint}" Placeholder="https://awx.internal" />
                                </Border>
                            </VerticalStackLayout>
                            <VerticalStackLayout Grid.Column="1" Spacing="4">
                                <Label Text="Token" Style="{StaticResource Caption}" />
                                <Border Style="{StaticResource FieldBorder}">
                                    <Entry Text="{Binding AwxToken}" IsPassword="True" />
                                </Border>
                            </VerticalStackLayout>
                            <VerticalStackLayout Grid.Column="2" Spacing="4">
                                <Label Text="Job template id" Style="{StaticResource Caption}" />
                                <Border Style="{StaticResource FieldBorder}">
                                    <Entry Text="{Binding AwxJobTemplateId}" Keyboard="Numeric" Placeholder="1" />
                                </Border>
                            </VerticalStackLayout>
                        </Grid>

                        <VerticalStackLayout Spacing="8" IsVisible="{Binding IsAwxUseExisting}">
                            <Label Text="OAuth2 auto-renew (optional — AWX tokens expire; fill client id + refresh token to let Iris renew automatically. Client secret only for a Confidential application, blank for a Public one.)"
                                   Style="{StaticResource Caption}" />
                            <Grid ColumnDefinitions="*,*,*" ColumnSpacing="10">
                                <VerticalStackLayout Spacing="4">
                                    <Label Text="OAuth2 client id" Style="{StaticResource Caption}" />
                                    <Border Style="{StaticResource FieldBorder}">
                                        <Entry Text="{Binding AwxOAuthClientId}" />
                                    </Border>
                                </VerticalStackLayout>
                                <VerticalStackLayout Grid.Column="1" Spacing="4">
                                    <Label Text="Client secret" Style="{StaticResource Caption}" />
                                    <Border Style="{StaticResource FieldBorder}">
                                        <Entry Text="{Binding AwxOAuthClientSecret}" IsPassword="True" />
                                    </Border>
                                </VerticalStackLayout>
                                <VerticalStackLayout Grid.Column="2" Spacing="4">
                                    <Label Text="Refresh token" Style="{StaticResource Caption}" />
                                    <Border Style="{StaticResource FieldBorder}">
                                        <Entry Text="{Binding AwxRefreshToken}" IsPassword="True" />
                                    </Border>
                                </VerticalStackLayout>
                            </Grid>
                        </VerticalStackLayout>

                        <Label Text="{Binding AwxError}" IsVisible="{Binding HasAwxError}" FontSize="12"
                               TextColor="{AppThemeBinding Light={StaticResource Danger}, Dark={StaticResource DangerDark}}" />

                        <Grid ColumnDefinitions="Auto,*" ColumnSpacing="10" Margin="0,4,0,0">
                            <Button Text="Back" Style="{StaticResource SecondaryButton}" Command="{Binding BackToOpenBaoStepCommand}" />
                            <Button Grid.Column="1" Text="Next" Command="{Binding GoToMailStepCommand}" HorizontalOptions="Fill" />
                        </Grid>
                    </VerticalStackLayout>

                    <!-- ===== Step 3: mail provider ===== -->
                    <VerticalStackLayout Spacing="12" IsVisible="{Binding IsMailStep}">
                        <Label Style="{StaticResource Body}"
                               Text="Where should Iris send invitation emails from? Any SMTP relay works — Office 365, Gmail, SendGrid…" />

                        <Grid ColumnDefinitions="2*,1*" ColumnSpacing="10">
                            <VerticalStackLayout Spacing="4">
                                <Label Text="SMTP host" Style="{StaticResource Caption}" />
                                <Border Style="{StaticResource FieldBorder}">
                                    <Entry Text="{Binding SmtpHost}" Placeholder="smtp.office365.com" />
                                </Border>
                            </VerticalStackLayout>
                            <VerticalStackLayout Grid.Column="1" Spacing="4">
                                <Label Text="Port" Style="{StaticResource Caption}" />
                                <Border Style="{StaticResource FieldBorder}">
                                    <Entry Text="{Binding SmtpPort}" Keyboard="Numeric" Placeholder="587" />
                                </Border>
                            </VerticalStackLayout>
                        </Grid>

                        <Grid ColumnDefinitions="*,*" ColumnSpacing="10">
                            <VerticalStackLayout Spacing="4">
                                <Label Text="Username (optional)" Style="{StaticResource Caption}" />
                                <Border Style="{StaticResource FieldBorder}">
                                    <Entry Text="{Binding SmtpUsername}" Placeholder="no-reply@company.com" />
                                </Border>
                            </VerticalStackLayout>
                            <VerticalStackLayout Grid.Column="1" Spacing="4">
                                <Label Text="Password" Style="{StaticResource Caption}" />
                                <Border Style="{StaticResource FieldBorder}">
                                    <Entry Text="{Binding SmtpPassword}" IsPassword="True" />
                                </Border>
                            </VerticalStackLayout>
                        </Grid>

                        <Grid ColumnDefinitions="*,*" ColumnSpacing="10">
                            <VerticalStackLayout Spacing="4">
                                <Label Text="From address" Style="{StaticResource Caption}" />
                                <Border Style="{StaticResource FieldBorder}">
                                    <Entry Text="{Binding FromAddress}" Placeholder="no-reply@company.com" Keyboard="Email" />
                                </Border>
                            </VerticalStackLayout>
                            <VerticalStackLayout Grid.Column="1" Spacing="4">
                                <Label Text="From name (optional)" Style="{StaticResource Caption}" />
                                <Border Style="{StaticResource FieldBorder}">
                                    <Entry Text="{Binding FromDisplayName}" Placeholder="Iris" />
                                </Border>
                            </VerticalStackLayout>
                        </Grid>

                        <HorizontalStackLayout Spacing="10">
                            <Switch IsToggled="{Binding EnableSsl}" VerticalOptions="Center" />
                            <Label Text="Use TLS/SSL" VerticalOptions="Center" Style="{StaticResource Caption}" />
                        </HorizontalStackLayout>

                        <Label Text="{Binding MailError}" IsVisible="{Binding HasMailError}" FontSize="12"
                               TextColor="{AppThemeBinding Light={StaticResource Danger}, Dark={StaticResource DangerDark}}" />

                        <Button Text="Next" Command="{Binding GoToAdminStepCommand}" HorizontalOptions="Fill" Margin="0,4,0,0" />
                    </VerticalStackLayout>

                    <!-- ===== Step 4: super-admin ===== -->
                    <VerticalStackLayout Spacing="12" IsVisible="{Binding IsAdminStep}">
                        <Label Style="{StaticResource Body}"
                               Text="Now create your administrator account — full access to every customer and setting." />

                        <VerticalStackLayout Spacing="4">
                            <Label Text="Email" Style="{StaticResource Caption}" />
                            <Border Style="{StaticResource FieldBorder}">
                                <Entry Text="{Binding AdminEmail}" Placeholder="you@company.com" Keyboard="Email" />
                            </Border>
                        </VerticalStackLayout>

                        <VerticalStackLayout Spacing="4">
                            <Label Text="Display name" Style="{StaticResource Caption}" />
                            <Border Style="{StaticResource FieldBorder}">
                                <Entry Text="{Binding AdminDisplayName}" Placeholder="Full name" />
                            </Border>
                        </VerticalStackLayout>

                        <Grid ColumnDefinitions="*,*" ColumnSpacing="10">
                            <VerticalStackLayout Spacing="4">
                                <Label Text="Password" Style="{StaticResource Caption}" />
                                <Border Style="{StaticResource FieldBorder}">
                                    <Entry Text="{Binding AdminPassword}" IsPassword="True" Placeholder="At least 8 characters" />
                                </Border>
                            </VerticalStackLayout>
                            <VerticalStackLayout Grid.Column="1" Spacing="4">
                                <Label Text="Confirm password" Style="{StaticResource Caption}" />
                                <Border Style="{StaticResource FieldBorder}">
                                    <Entry Text="{Binding ConfirmPassword}" IsPassword="True" Placeholder="Repeat the password" />
                                </Border>
                            </VerticalStackLayout>
                        </Grid>

                        <Label Text="{Binding AdminError}" IsVisible="{Binding HasAdminError}" FontSize="12"
                               TextColor="{AppThemeBinding Light={StaticResource Danger}, Dark={StaticResource DangerDark}}" />

                        <!-- Setup itself is one-shot and already succeeded once SetupCompleted is
                             true — Back/Finish setup no longer apply. A warning (e.g. OpenBao
                             provisioning failed) stays on screen here until the operator
                             acknowledges it, instead of being discarded by an immediate
                             auto-navigate to the dashboard. -->
                        <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="10" Margin="0,4,0,0"
                              IsVisible="{Binding ShowSetupControls}">
                            <ActivityIndicator IsRunning="{Binding IsBusy}" IsVisible="{Binding IsBusy}" VerticalOptions="Center" />
                            <Button Grid.Column="1" Text="Back" Style="{StaticResource SecondaryButton}"
                                    Command="{Binding BackToMailStepCommand}" HorizontalOptions="End" />
                            <Button Grid.Column="2" Text="Finish setup" Command="{Binding CompleteCommand}" />
                        </Grid>

                        <Button Text="Continue to dashboard" Command="{Binding ContinueToDashboardCommand}"
                                HorizontalOptions="Fill" Margin="0,4,0,0"
                                IsVisible="{Binding SetupCompleted}" />
                    </VerticalStackLayout>

                </VerticalStackLayout>
            </Border>
        </Grid>
    </ScrollView>
</ContentPage>
