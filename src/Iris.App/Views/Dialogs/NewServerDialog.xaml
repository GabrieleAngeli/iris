<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    x:Class="Iris.App.Views.Dialogs.NewServerDialog"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:vm="clr-namespace:Iris.App.ViewModels"
    x:DataType="vm:ServersViewModel"
    Title="New server">

    <Grid RowDefinitions="*,Auto"
          BackgroundColor="{AppThemeBinding Light={StaticResource AppBackgroundLight}, Dark={StaticResource AppBackgroundDark}}">

        <ScrollView>
            <VerticalStackLayout Padding="22" Spacing="10">
                <Label Text="Register an infrastructure target for deployments." Style="{StaticResource Caption}" />

                <VerticalStackLayout Spacing="4">
                    <Label Text="Resource type" Style="{StaticResource Caption}" />
                    <Border Style="{StaticResource FieldBorder}">
                        <Picker ItemsSource="{Binding NewResourceKindOptions}" SelectedItem="{Binding NewResourceKind}" />
                    </Border>
                </VerticalStackLayout>

                <Grid ColumnDefinitions="*,*" ColumnSpacing="10" IsVisible="{Binding IsNewServerResource}">
                    <VerticalStackLayout Spacing="4">
                        <Label Text="Name" Style="{StaticResource Caption}" />
                        <Border Style="{StaticResource FieldBorder}">
                            <Entry Text="{Binding NewServerName}" Placeholder="web-01" />
                        </Border>
                    </VerticalStackLayout>
                    <VerticalStackLayout Grid.Column="1" Spacing="4">
                        <Label Text="Hostname / FQDN" Style="{StaticResource Caption}" />
                        <Border Style="{StaticResource FieldBorder}">
                            <Entry Text="{Binding NewServerHostname}" Placeholder="web-01.contoso.internal" />
                        </Border>
                    </VerticalStackLayout>
                </Grid>

                <Grid ColumnDefinitions="*,*,*" ColumnSpacing="10" IsVisible="{Binding IsNewServerResource}">
                    <VerticalStackLayout Spacing="4">
                        <Label Text="OS" Style="{StaticResource Caption}" />
                        <Border Style="{StaticResource FieldBorder}">
                            <Picker ItemsSource="{Binding OsOptions}" SelectedItem="{Binding NewServerOs}" />
                        </Border>
                    </VerticalStackLayout>
                    <VerticalStackLayout Grid.Column="1" Spacing="4">
                        <Label Text="Hosting" Style="{StaticResource Caption}" />
                        <Border Style="{StaticResource FieldBorder}">
                            <Picker ItemsSource="{Binding HostingTypeOptions}" SelectedItem="{Binding NewServerHostingType}" />
                        </Border>
                    </VerticalStackLayout>
                    <VerticalStackLayout Grid.Column="2" Spacing="4">
                        <Label Text="Environment" Style="{StaticResource Caption}" />
                        <Border Style="{StaticResource FieldBorder}">
                            <Picker ItemsSource="{Binding EnvironmentOptions}" SelectedItem="{Binding NewServerEnvironment}" />
                        </Border>
                    </VerticalStackLayout>
                </Grid>

                <Grid ColumnDefinitions="*,*" ColumnSpacing="10" IsVisible="{Binding IsNewServerResource}">
                    <VerticalStackLayout Spacing="4">
                        <Label Text="Public IP" Style="{StaticResource Caption}" />
                        <Border Style="{StaticResource FieldBorder}">
                            <Entry Text="{Binding NewServerPublicIp}" Placeholder="203.0.113.10" />
                        </Border>
                    </VerticalStackLayout>
                    <VerticalStackLayout Grid.Column="1" Spacing="4">
                        <Label Text="Private IP" Style="{StaticResource Caption}" />
                        <Border Style="{StaticResource FieldBorder}">
                            <Entry Text="{Binding NewServerPrivateIp}" Placeholder="10.0.4.12" />
                        </Border>
                    </VerticalStackLayout>
                </Grid>
                <Label Text="At least one of the two IPs is required." Style="{StaticResource Caption}" IsVisible="{Binding IsNewServerResource}" />

                <BoxView HeightRequest="1" Margin="0,4" Color="{AppThemeBinding Light=#E6E1D6, Dark=#3A3A3A}" IsVisible="{Binding IsNewServerResource}" />
                <HorizontalStackLayout Spacing="8" IsVisible="{Binding IsNewServerResource}">
                    <CheckBox IsChecked="{Binding IncludeCredential}" VerticalOptions="Center" />
                    <Label Text="Add an OS-login credential now (username + password or SSH key)"
                           VerticalOptions="Center" Style="{StaticResource Caption}" />
                </HorizontalStackLayout>

                <VerticalStackLayout IsVisible="{Binding ShowNewServerCredentialSection}">
                    <VerticalStackLayout Spacing="10"
                                         BindingContext="{Binding NewServerCredential}"
                                         x:DataType="vm:CredentialFormViewModel">

                        <Grid ColumnDefinitions="*,*" ColumnSpacing="10">
                            <VerticalStackLayout Spacing="4">
                                <Label Text="Credential type" Style="{StaticResource Caption}" />
                                <Border Style="{StaticResource FieldBorder}">
                                    <Picker ItemsSource="{Binding KindOptions}" SelectedItem="{Binding Kind}" />
                                </Border>
                            </VerticalStackLayout>
                            <VerticalStackLayout Grid.Column="1" Spacing="4">
                                <Label Text="Auth method" Style="{StaticResource Caption}" />
                                <Border Style="{StaticResource FieldBorder}">
                                    <Picker ItemsSource="{Binding AuthMethods}" SelectedItem="{Binding AuthMethod}" />
                                </Border>
                            </VerticalStackLayout>
                        </Grid>

                        <Grid ColumnDefinitions="*,*" ColumnSpacing="10">
                            <VerticalStackLayout Spacing="4">
                                <Label Text="Username on the server" Style="{StaticResource Caption}" />
                                <Border Style="{StaticResource FieldBorder}">
                                    <Entry Text="{Binding Username}" Placeholder="root / deploy / ansible" />
                                </Border>
                            </VerticalStackLayout>
                            <VerticalStackLayout Grid.Column="1" Spacing="4" IsVisible="{Binding IsServiceAccount}">
                                <Label Text="Service name" Style="{StaticResource Caption}" />
                                <Border Style="{StaticResource FieldBorder}">
                                    <Entry Text="{Binding ServiceName}" Placeholder="ansible" />
                                </Border>
                            </VerticalStackLayout>
                            <VerticalStackLayout Grid.Column="1" Spacing="4" IsVisible="{Binding IsSystemUser}">
                                <Label Text="Linked Iris user (optional)" Style="{StaticResource Caption}" />
                                <Border Style="{StaticResource FieldBorder}">
                                    <Picker ItemsSource="{Binding OwnerOptions}" SelectedItem="{Binding SelectedOwner}" />
                                </Border>
                            </VerticalStackLayout>
                        </Grid>

                        <VerticalStackLayout Spacing="10" IsVisible="{Binding ShowSecretField}">
                            <VerticalStackLayout Spacing="4" IsVisible="{Binding IsPasswordAuth}">
                                <Label Text="Password" Style="{StaticResource Caption}" />
                                <Border Style="{StaticResource FieldBorder}">
                                    <Entry Text="{Binding SecretValue}" IsPassword="True" Placeholder="Stored in the secret store — never shown again" />
                                </Border>
                            </VerticalStackLayout>
                            <VerticalStackLayout Spacing="4" IsVisible="{Binding IsSshKeyAuth}">
                                <Label Text="SSH private key" Style="{StaticResource Caption}" />
                                <Border Style="{StaticResource FieldBorder}" MinimumHeightRequest="150">
                                    <Editor Text="{Binding SecretValue}" AutoSize="TextChanges" HeightRequest="140"
                                            Placeholder="-----BEGIN OPENSSH PRIVATE KEY-----&#10;…&#10;-----END OPENSSH PRIVATE KEY-----" />
                                </Border>
                            </VerticalStackLayout>
                        </VerticalStackLayout>

                        <VerticalStackLayout Spacing="4">
                            <Label Text="Note (optional)" Style="{StaticResource Caption}" />
                            <Border Style="{StaticResource FieldBorder}">
                                <Entry Text="{Binding Label}" Placeholder="e.g. break-glass root access" />
                            </Border>
                        </VerticalStackLayout>

                    </VerticalStackLayout>
                </VerticalStackLayout>

                <VerticalStackLayout Spacing="10" IsVisible="{Binding IsNewDataServiceResource}">
                    <Grid ColumnDefinitions="*,*" ColumnSpacing="10">
                        <VerticalStackLayout Spacing="4">
                            <Label Text="Name" Style="{StaticResource Caption}" />
                            <Border Style="{StaticResource FieldBorder}">
                                <Entry Text="{Binding NewDataServiceName}" Placeholder="orders-db" />
                            </Border>
                        </VerticalStackLayout>
                        <VerticalStackLayout Grid.Column="1" Spacing="4">
                            <Label Text="Service" Style="{StaticResource Caption}" />
                            <Border Style="{StaticResource FieldBorder}">
                                <Picker ItemsSource="{Binding DataServiceKindOptions}" SelectedItem="{Binding NewDataServiceKind}" />
                            </Border>
                        </VerticalStackLayout>
                    </Grid>

                    <Grid ColumnDefinitions="*,Auto" ColumnSpacing="10">
                        <VerticalStackLayout Spacing="4">
                            <Label Text="Endpoint" Style="{StaticResource Caption}" />
                            <Border Style="{StaticResource FieldBorder}">
                                <Entry Text="{Binding NewDataServiceEndpoint}" Placeholder="orders-db.cluster.local" />
                            </Border>
                        </VerticalStackLayout>
                        <VerticalStackLayout Grid.Column="1" Spacing="4">
                            <Label Text="Port" Style="{StaticResource Caption}" />
                            <Border Style="{StaticResource FieldBorder}" WidthRequest="120">
                                <Entry Text="{Binding NewDataServicePort}" Keyboard="Numeric" Placeholder="5432" />
                            </Border>
                        </VerticalStackLayout>
                    </Grid>

                    <Grid ColumnDefinitions="*,*" ColumnSpacing="10">
                        <VerticalStackLayout Spacing="4">
                            <Label Text="Environment" Style="{StaticResource Caption}" />
                            <Border Style="{StaticResource FieldBorder}">
                                <Picker ItemsSource="{Binding EnvironmentOptions}" SelectedItem="{Binding NewDataServiceEnvironment}" />
                            </Border>
                        </VerticalStackLayout>
                        <VerticalStackLayout Grid.Column="1" Spacing="4">
                            <Label Text="Storage GB" Style="{StaticResource Caption}" />
                            <Border Style="{StaticResource FieldBorder}">
                                <Entry Text="{Binding NewDataServiceStorageGb}" Keyboard="Numeric" Placeholder="100" />
                            </Border>
                        </VerticalStackLayout>
                    </Grid>

                    <Grid ColumnDefinitions="*,*" ColumnSpacing="10">
                        <VerticalStackLayout Spacing="4">
                            <Label Text="Username" Style="{StaticResource Caption}" />
                            <Border Style="{StaticResource FieldBorder}">
                                <Entry Text="{Binding NewDataServiceUsername}" Placeholder="dbadmin" />
                            </Border>
                        </VerticalStackLayout>
                        <VerticalStackLayout Grid.Column="1" Spacing="4">
                            <Label Text="Password" Style="{StaticResource Caption}" />
                            <Border Style="{StaticResource FieldBorder}">
                                <Entry Text="{Binding NewDataServicePassword}" IsPassword="True" Placeholder="Stored in the secret store" />
                            </Border>
                        </VerticalStackLayout>
                    </Grid>
                </VerticalStackLayout>

                <Label Text="{Binding CreateResourceError}" IsVisible="{Binding HasCreateResourceError}" FontSize="12"
                       TextColor="{AppThemeBinding Light={StaticResource Danger}, Dark={StaticResource DangerDark}}" />
            </VerticalStackLayout>
        </ScrollView>

        <Grid Grid.Row="1" ColumnDefinitions="*,Auto,Auto" ColumnSpacing="10" Padding="22,12"
              BackgroundColor="{AppThemeBinding Light={StaticResource LayerLight}, Dark={StaticResource LayerDark}}">
            <ActivityIndicator IsRunning="{Binding IsCreatingResource}" IsVisible="{Binding IsCreatingResource}" HorizontalOptions="Start" />
            <Button Grid.Column="1" Text="Cancel" Style="{StaticResource SecondaryButton}" Clicked="OnCancel" />
            <Button Grid.Column="2" Text="Create" Command="{Binding CreateSelectedResourceCommand}"
                    IsEnabled="{Binding IsCreatingResource, Converter={StaticResource InvertBoolConverter}}" />
        </Grid>
    </Grid>
</ContentPage>
