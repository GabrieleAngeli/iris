<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    x:Class="Iris.App.Views.Dialogs.ConfirmDeleteDialog"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:vm="clr-namespace:Iris.App.ViewModels"
    x:DataType="vm:IConfirmDeletable"
    Title="Confirm deletion">

    <Grid RowDefinitions="*,Auto"
          BackgroundColor="{AppThemeBinding Light={StaticResource AppBackgroundLight}, Dark={StaticResource AppBackgroundDark}}">

        <ScrollView>
            <VerticalStackLayout Padding="22" Spacing="14">

                <Label Text="{Binding DeleteDialogTitle}" Style="{StaticResource Subtitle}"
                       TextColor="{AppThemeBinding Light={StaticResource Danger}, Dark={StaticResource DangerDark}}" />

                <Label Text="{Binding DeleteDialogPrompt}" Style="{StaticResource Body}" />

                <VerticalStackLayout Spacing="4">
                    <Label Text="{Binding DeleteTargetName, StringFormat='Type &quot;{0}&quot; to confirm'}"
                           Style="{StaticResource Caption}" />
                    <Border Style="{StaticResource FieldBorder}">
                        <Entry Text="{Binding DeleteConfirmName}" Placeholder="{Binding DeleteTargetName}" />
                    </Border>
                </VerticalStackLayout>

                <Label Text="{Binding EditError}" IsVisible="{Binding HasEditError}" FontSize="12"
                       TextColor="{AppThemeBinding Light={StaticResource Danger}, Dark={StaticResource DangerDark}}" />
            </VerticalStackLayout>
        </ScrollView>

        <Grid Grid.Row="1" ColumnDefinitions="*,Auto,Auto" ColumnSpacing="10" Padding="22,12"
              BackgroundColor="{AppThemeBinding Light={StaticResource LayerLight}, Dark={StaticResource LayerDark}}">
            <ActivityIndicator IsRunning="{Binding IsEditBusy}" IsVisible="{Binding IsEditBusy}" HorizontalOptions="Start" />
            <Button Grid.Column="1" Text="Cancel" Style="{StaticResource SecondaryButton}" Clicked="OnCancel" />
            <Button Grid.Column="2" Text="Delete" Command="{Binding DeleteCommand}"
                    BackgroundColor="{AppThemeBinding Light={StaticResource Danger}, Dark={StaticResource DangerDark}}"
                    TextColor="White" />
        </Grid>
    </Grid>
</ContentPage>
