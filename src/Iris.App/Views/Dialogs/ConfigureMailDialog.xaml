<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    x:Class="Iris.App.Views.Dialogs.ConfigureMailDialog"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:vm="clr-namespace:Iris.App.ViewModels"
    x:DataType="vm:ConfigureMailDialogViewModel"
    Title="Edit SMTP">

    <Grid RowDefinitions="*,Auto"
          BackgroundColor="{AppThemeBinding Light={StaticResource AppBackgroundLight}, Dark={StaticResource AppBackgroundDark}}">

        <ScrollView>
            <VerticalStackLayout Padding="22" Spacing="14">
                <VerticalStackLayout Spacing="4">
                    <Label Text="Edit SMTP" Style="{StaticResource Subtitle}" />
                    <Label Text="Takes effect immediately — no Iris.Api restart needed. Leave the password blank to keep the one already saved." Style="{StaticResource Caption}" />
                </VerticalStackLayout>

                <Border IsVisible="{Binding HasError}"
                        BackgroundColor="{AppThemeBinding Light=#FDE7E9, Dark=#442726}"
                        Stroke="{AppThemeBinding Light=#F1BBBB, Dark=#7A3B38}"
                        StrokeThickness="1" Padding="12,10" StrokeShape="RoundRectangle 6">
                    <Label Text="{Binding Error}" FontSize="12"
                           TextColor="{AppThemeBinding Light={StaticResource Danger}, Dark={StaticResource DangerDark}}" />
                </Border>

                <Border IsVisible="{Binding HasInfo}"
                        BackgroundColor="{AppThemeBinding Light=#E6F4EA, Dark=#1F3A28}"
                        Stroke="{AppThemeBinding Light=#B7DFC2, Dark=#356241}"
                        StrokeThickness="1" Padding="12,10" StrokeShape="RoundRectangle 6">
                    <Label Text="{Binding Info}" FontSize="12"
                           TextColor="{AppThemeBinding Light={StaticResource Success}, Dark={StaticResource SuccessDark}}" />
                </Border>

                <Grid ColumnDefinitions="2*,1*" ColumnSpacing="10">
                    <VerticalStackLayout Spacing="5">
                        <Label Text="SMTP host" Style="{StaticResource Caption}" />
                        <Border Style="{StaticResource FieldBorder}">
                            <Entry Text="{Binding SmtpHost}" Placeholder="smtp.office365.com" />
                        </Border>
                    </VerticalStackLayout>
                    <VerticalStackLayout Grid.Column="1" Spacing="5">
                        <Label Text="Port" Style="{StaticResource Caption}" />
                        <Border Style="{StaticResource FieldBorder}">
                            <Entry Text="{Binding SmtpPort}" Keyboard="Numeric" Placeholder="587" />
                        </Border>
                    </VerticalStackLayout>
                </Grid>

                <Grid ColumnDefinitions="1*,1*" ColumnSpacing="10">
                    <VerticalStackLayout Spacing="5">
                        <Label Text="Username (optional)" Style="{StaticResource Caption}" />
                        <Border Style="{StaticResource FieldBorder}">
                            <Entry Text="{Binding SmtpUsername}" Placeholder="no-reply@company.com" />
                        </Border>
                    </VerticalStackLayout>
                    <VerticalStackLayout Grid.Column="1" Spacing="5">
                        <Label Text="Password (leave blank to keep it)" Style="{StaticResource Caption}" />
                        <Border Style="{StaticResource FieldBorder}">
                            <Entry Text="{Binding SmtpPassword}" IsPassword="True" />
                        </Border>
                    </VerticalStackLayout>
                </Grid>

                <Grid ColumnDefinitions="1*,1*" ColumnSpacing="10">
                    <VerticalStackLayout Spacing="5">
                        <Label Text="From address" Style="{StaticResource Caption}" />
                        <Border Style="{StaticResource FieldBorder}">
                            <Entry Text="{Binding FromAddress}" Placeholder="no-reply@company.com" Keyboard="Email" />
                        </Border>
                    </VerticalStackLayout>
                    <VerticalStackLayout Grid.Column="1" Spacing="5">
                        <Label Text="From name (optional)" Style="{StaticResource Caption}" />
                        <Border Style="{StaticResource FieldBorder}">
                            <Entry Text="{Binding FromDisplayName}" Placeholder="Iris" />
                        </Border>
                    </VerticalStackLayout>
                </Grid>

                <HorizontalStackLayout Spacing="10">
                    <Switch IsToggled="{Binding EnableSsl}" VerticalOptions="Center" />
                    <Label Text="Use TLS/SSL" VerticalOptions="Center" Style="{StaticResource Caption}" />
                </HorizontalStackLayout>

                <BoxView HeightRequest="1" Color="{AppThemeBinding Light=#E5E5E5, Dark=#3A3A3A}" Margin="0,4" />

                <VerticalStackLayout Spacing="5">
                    <Label Text="Send a test email to (optional, before saving)" Style="{StaticResource Caption}" />
                    <Grid ColumnDefinitions="*,Auto" ColumnSpacing="10">
                        <Border Style="{StaticResource FieldBorder}">
                            <Entry Text="{Binding TestRecipient}" Placeholder="you@company.com" Keyboard="Email" />
                        </Border>
                        <Button Grid.Column="1" Text="Send test" Style="{StaticResource SecondaryButton}"
                                Command="{Binding SendTestEmailCommand}" />
                    </Grid>
                </VerticalStackLayout>
            </VerticalStackLayout>
        </ScrollView>

        <Grid Grid.Row="1" ColumnDefinitions="Auto,*,Auto" ColumnSpacing="10" Padding="22,12"
              BackgroundColor="{AppThemeBinding Light={StaticResource LayerLight}, Dark={StaticResource LayerDark}}">
            <ActivityIndicator IsRunning="{Binding IsBusy}" IsVisible="{Binding IsBusy}" VerticalOptions="Center" />
            <Button Grid.Column="1" Text="Cancel" Style="{StaticResource SecondaryButton}" HorizontalOptions="End" Clicked="OnCancel" />
            <Button Grid.Column="2" Text="Save" Command="{Binding SaveCommand}" />
        </Grid>
    </Grid>
</ContentPage>
