<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    x:Class="Iris.App.Views.Dialogs.EditUserDialog"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:vm="clr-namespace:Iris.App.ViewModels"
    x:DataType="vm:UserRowViewModel"
    Title="Edit user">

    <Grid RowDefinitions="*,Auto"
          BackgroundColor="{AppThemeBinding Light={StaticResource AppBackgroundLight}, Dark={StaticResource AppBackgroundDark}}">

        <ScrollView>
            <VerticalStackLayout Padding="22" Spacing="10">

                <VerticalStackLayout Spacing="4">
                    <Label Text="Display name" Style="{StaticResource Caption}" />
                    <Border Style="{StaticResource FieldBorder}">
                        <Entry Text="{Binding EditDisplayName}" Placeholder="Full name" />
                    </Border>
                </VerticalStackLayout>

                <VerticalStackLayout Spacing="4">
                    <Label Text="Email" Style="{StaticResource Caption}" />
                    <Border Style="{StaticResource FieldBorder}">
                        <Entry Text="{Binding EditEmail}" Placeholder="name@company.com" Keyboard="Email" />
                    </Border>
                    <Label Text="For a signed-in user this is refreshed from Microsoft 365 on next sign-in."
                           Style="{StaticResource Caption}" />
                </VerticalStackLayout>

                <HorizontalStackLayout Spacing="10">
                    <Switch IsToggled="{Binding EditActive}" VerticalOptions="Center" />
                    <Label Text="Active" VerticalOptions="Center" Style="{StaticResource Caption}" />
                </HorizontalStackLayout>

                <Label Text="{Binding EditError}" IsVisible="{Binding HasEditError}" FontSize="12"
                       TextColor="{AppThemeBinding Light={StaticResource Danger}, Dark={StaticResource DangerDark}}" />

                <!-- ===== Danger zone ===== -->
                <Border Margin="0,10,0,0" Padding="16" StrokeThickness="1"
                        StrokeShape="RoundRectangle 8"
                        Stroke="{AppThemeBinding Light=#F1BBBB, Dark=#7A3B38}"
                        BackgroundColor="{AppThemeBinding Light=#FDF3F3, Dark=#2A1E1E}">
                    <VerticalStackLayout Spacing="8">
                        <Label Text="Delete this user" FontFamily="{StaticResource FontSemibold}"
                               TextColor="{AppThemeBinding Light={StaticResource Danger}, Dark={StaticResource DangerDark}}" />
                        <Label Style="{StaticResource Caption}"
                               Text="{Binding DisplayName, StringFormat='This removes the user and every role assignment they hold. Type &quot;{0}&quot; to confirm.'}" />
                        <Border Style="{StaticResource FieldBorder}">
                            <Entry Text="{Binding DeleteConfirmName}" Placeholder="{Binding DisplayName}" />
                        </Border>
                        <Button Text="Delete user" Command="{Binding DeleteCommand}" HorizontalOptions="Start"
                                BackgroundColor="{AppThemeBinding Light={StaticResource Danger}, Dark={StaticResource DangerDark}}"
                                TextColor="White" />
                    </VerticalStackLayout>
                </Border>
            </VerticalStackLayout>
        </ScrollView>

        <Grid Grid.Row="1" ColumnDefinitions="*,Auto,Auto" ColumnSpacing="10" Padding="22,12"
              BackgroundColor="{AppThemeBinding Light={StaticResource LayerLight}, Dark={StaticResource LayerDark}}">
            <ActivityIndicator IsRunning="{Binding IsEditBusy}" IsVisible="{Binding IsEditBusy}" HorizontalOptions="Start" />
            <Button Grid.Column="1" Text="Cancel" Style="{StaticResource SecondaryButton}" Clicked="OnCancel" />
            <Button Grid.Column="2" Text="Save" Command="{Binding SaveEditCommand}"
                    IsEnabled="{Binding IsEditBusy, Converter={StaticResource InvertBoolConverter}}" />
        </Grid>
    </Grid>
</ContentPage>
