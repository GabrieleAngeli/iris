<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    x:Class="Iris.App.Views.Dialogs.EditUserDialog"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:vm="clr-namespace:Iris.App.ViewModels"
    x:DataType="vm:UserRowViewModel"
    Title="Edit user">

    <Grid RowDefinitions="*,Auto"
          BackgroundColor="{AppThemeBinding Light={StaticResource AppBackgroundLight}, Dark={StaticResource AppBackgroundDark}}">

        <ScrollView>
            <VerticalStackLayout Padding="22" Spacing="10">

                <VerticalStackLayout Spacing="4">
                    <Label Text="Display name" Style="{StaticResource Caption}" />
                    <Border Style="{StaticResource FieldBorder}">
                        <Entry Text="{Binding EditDisplayName}" Placeholder="Full name" />
                    </Border>
                </VerticalStackLayout>

                <VerticalStackLayout Spacing="4">
                    <Label Text="Email" Style="{StaticResource Caption}" />
                    <Border Style="{StaticResource FieldBorder}">
                        <Entry Text="{Binding EditEmail}" Placeholder="name@company.com" Keyboard="Email" />
                    </Border>
                    <Label Text="For a signed-in user this is refreshed from Microsoft 365 on next sign-in."
                           Style="{StaticResource Caption}" />
                </VerticalStackLayout>

                <HorizontalStackLayout Spacing="10">
                    <Switch IsToggled="{Binding EditActive}" VerticalOptions="Center" />
                    <Label Text="Active" VerticalOptions="Center" Style="{StaticResource Caption}" />
                </HorizontalStackLayout>

                <Label Text="{Binding EditError}" IsVisible="{Binding HasEditError}" FontSize="12"
                       TextColor="{AppThemeBinding Light={StaticResource Danger}, Dark={StaticResource DangerDark}}" />

                <!-- ===== Roles ===== -->
                <BoxView HeightRequest="1" Margin="0,8,0,0"
                         Color="{AppThemeBinding Light={StaticResource StrokeLight}, Dark={StaticResource StrokeDark}}" />
                <Label Text="Roles" Style="{StaticResource Caption}" />

                <VerticalStackLayout Spacing="0" BindableLayout.ItemsSource="{Binding Assignments}">
                    <BindableLayout.ItemTemplate>
                        <DataTemplate x:DataType="vm:AssignmentRowViewModel">
                            <Grid ColumnDefinitions="*,Auto" Padding="0,6" ColumnSpacing="8">
                                <VerticalStackLayout Spacing="0">
                                    <Label Text="{Binding RoleName}" Style="{StaticResource Body}" FontAttributes="Bold" />
                                    <Label Text="{Binding ScopeDescription}" Style="{StaticResource Caption}" />
                                </VerticalStackLayout>
                                <Button Grid.Column="1" Text="Revoke" Style="{StaticResource LinkButton}"
                                        Command="{Binding Owner.RevokeCommand}" CommandParameter="{Binding .}" />
                            </Grid>
                        </DataTemplate>
                    </BindableLayout.ItemTemplate>
                </VerticalStackLayout>

                <Label Text="{Binding AssignError}" IsVisible="{Binding HasAssignError}" FontSize="12"
                       TextColor="{AppThemeBinding Light={StaticResource Danger}, Dark={StaticResource DangerDark}}" />

                <HorizontalStackLayout Spacing="8">
                    <Button Text="Assign a role…" Command="{Binding RequestAssignFromEditCommand}"
                            Style="{StaticResource SecondaryButton}" />
                    <Button Text="Send invitation…" Command="{Binding RequestInviteCommand}"
                            Style="{StaticResource SecondaryButton}" />
                </HorizontalStackLayout>

                <!-- ===== Delete ===== -->
                <BoxView HeightRequest="1" Margin="0,10,0,0"
                         Color="{AppThemeBinding Light={StaticResource StrokeLight}, Dark={StaticResource StrokeDark}}" />
                <Button Text="Delete this user…" Command="{Binding RequestDeleteCommand}"
                        Style="{StaticResource LinkButton}" HorizontalOptions="Start"
                        TextColor="{AppThemeBinding Light={StaticResource Danger}, Dark={StaticResource DangerDark}}" />
            </VerticalStackLayout>
        </ScrollView>

        <Grid Grid.Row="1" ColumnDefinitions="*,Auto,Auto" ColumnSpacing="10" Padding="22,12"
              BackgroundColor="{AppThemeBinding Light={StaticResource LayerLight}, Dark={StaticResource LayerDark}}">
            <ActivityIndicator IsRunning="{Binding IsEditBusy}" IsVisible="{Binding IsEditBusy}" HorizontalOptions="Start" />
            <Button Grid.Column="1" Text="Cancel" Style="{StaticResource SecondaryButton}" Clicked="OnCancel" />
            <Button Grid.Column="2" Text="Save" Command="{Binding SaveEditCommand}"
                    IsEnabled="{Binding IsEditBusy, Converter={StaticResource InvertBoolConverter}}" />
        </Grid>
    </Grid>
</ContentPage>
