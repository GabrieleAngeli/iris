<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    x:Class="Iris.App.Views.Dialogs.AddCredentialDialog"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:vm="clr-namespace:Iris.App.ViewModels"
    x:DataType="vm:ServerRowViewModel"
    Title="Add credential">

    <Grid RowDefinitions="*,Auto"
          BackgroundColor="{AppThemeBinding Light={StaticResource AppBackgroundLight}, Dark={StaticResource AppBackgroundDark}}">

        <ScrollView>
            <VerticalStackLayout Padding="22" Spacing="10">
                <Label Text="{Binding Name, StringFormat='OS-login credential for {0}'}" Style="{StaticResource Caption}" />

                <VerticalStackLayout Spacing="10"
                                     BindingContext="{Binding AddCredentialForm}"
                                     x:DataType="vm:CredentialFormViewModel">

                    <Grid ColumnDefinitions="*,*" ColumnSpacing="10">
                        <VerticalStackLayout Spacing="4">
                            <Label Text="Credential type" Style="{StaticResource Caption}" />
                            <Picker ItemsSource="{Binding KindOptions}" SelectedItem="{Binding Kind}" />
                        </VerticalStackLayout>
                        <VerticalStackLayout Grid.Column="1" Spacing="4">
                            <Label Text="Auth method" Style="{StaticResource Caption}" />
                            <Picker ItemsSource="{Binding AuthMethods}" SelectedItem="{Binding AuthMethod}" />
                        </VerticalStackLayout>
                    </Grid>

                    <Grid ColumnDefinitions="*,*" ColumnSpacing="10">
                        <VerticalStackLayout Spacing="4">
                            <Label Text="Username on the server" Style="{StaticResource Caption}" />
                            <Border Style="{StaticResource FieldBorder}">
                                <Entry Text="{Binding Username}" Placeholder="root / deploy / ansible" />
                            </Border>
                        </VerticalStackLayout>
                        <VerticalStackLayout Grid.Column="1" Spacing="4" IsVisible="{Binding IsServiceAccount}">
                            <Label Text="Service name" Style="{StaticResource Caption}" />
                            <Border Style="{StaticResource FieldBorder}">
                                <Entry Text="{Binding ServiceName}" Placeholder="ansible" />
                            </Border>
                        </VerticalStackLayout>
                        <VerticalStackLayout Grid.Column="1" Spacing="4" IsVisible="{Binding IsSystemUser}">
                            <Label Text="Linked Iris user (optional)" Style="{StaticResource Caption}" />
                            <Picker ItemsSource="{Binding OwnerOptions}" SelectedItem="{Binding SelectedOwner}" />
                        </VerticalStackLayout>
                    </Grid>

                    <VerticalStackLayout Spacing="10" IsVisible="{Binding ShowSecretField}">
                        <VerticalStackLayout Spacing="4" IsVisible="{Binding IsPasswordAuth}">
                            <Label Text="Password" Style="{StaticResource Caption}" />
                            <Border Style="{StaticResource FieldBorder}">
                                <Entry Text="{Binding SecretValue}" IsPassword="True" Placeholder="Stored in the secret store — never shown again" />
                            </Border>
                        </VerticalStackLayout>
                        <VerticalStackLayout Spacing="4" IsVisible="{Binding IsSshKeyAuth}">
                            <Label Text="SSH private key" Style="{StaticResource Caption}" />
                            <Border Style="{StaticResource FieldBorder}" MinimumHeightRequest="150">
                                <Editor Text="{Binding SecretValue}" AutoSize="TextChanges" HeightRequest="140"
                                        Placeholder="-----BEGIN OPENSSH PRIVATE KEY-----&#10;…&#10;-----END OPENSSH PRIVATE KEY-----" />
                            </Border>
                        </VerticalStackLayout>
                    </VerticalStackLayout>

                    <VerticalStackLayout Spacing="4">
                        <Label Text="Note (optional)" Style="{StaticResource Caption}" />
                        <Border Style="{StaticResource FieldBorder}">
                            <Entry Text="{Binding Label}" Placeholder="e.g. CI deploy account" />
                        </Border>
                    </VerticalStackLayout>

                </VerticalStackLayout>

                <Label Text="{Binding CredentialError}" IsVisible="{Binding HasCredentialError}" FontSize="12"
                       TextColor="{AppThemeBinding Light={StaticResource Danger}, Dark={StaticResource DangerDark}}" />
            </VerticalStackLayout>
        </ScrollView>

        <Grid Grid.Row="1" ColumnDefinitions="*,Auto,Auto" ColumnSpacing="10" Padding="22,12"
              BackgroundColor="{AppThemeBinding Light={StaticResource LayerLight}, Dark={StaticResource LayerDark}}">
            <ActivityIndicator IsRunning="{Binding IsBusy}" IsVisible="{Binding IsBusy}" HorizontalOptions="Start" />
            <Button Grid.Column="1" Text="Cancel" Style="{StaticResource SecondaryButton}" Clicked="OnCancel" />
            <Button Grid.Column="2" Text="Add" Command="{Binding AddCredentialCommand}"
                    IsEnabled="{Binding IsBusy, Converter={StaticResource InvertBoolConverter}}" />
        </Grid>
    </Grid>
</ContentPage>
