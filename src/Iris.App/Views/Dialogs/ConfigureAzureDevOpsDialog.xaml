<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    x:Class="Iris.App.Views.Dialogs.ConfigureAzureDevOpsDialog"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:vm="clr-namespace:Iris.App.ViewModels"
    x:DataType="vm:ConfigureAzureDevOpsDialogViewModel"
    Title="Configure Azure DevOps">

    <Grid RowDefinitions="*,Auto"
          BackgroundColor="{AppThemeBinding Light={StaticResource AppBackgroundLight}, Dark={StaticResource AppBackgroundDark}}">

        <ScrollView>
            <VerticalStackLayout Padding="22" Spacing="14">
                <VerticalStackLayout Spacing="4">
                    <Label Text="Configure Azure DevOps" Style="{StaticResource Subtitle}" />
                    <Label Text="Point Iris at your Azure DevOps organization. Leave the token blank to keep the one already saved." Style="{StaticResource Caption}" />
                </VerticalStackLayout>

                <Border IsVisible="{Binding HasError}"
                        BackgroundColor="{AppThemeBinding Light=#FDE7E9, Dark=#442726}"
                        Stroke="{AppThemeBinding Light=#F1BBBB, Dark=#7A3B38}"
                        StrokeThickness="1"
                        Padding="12,10"
                        StrokeShape="RoundRectangle 6">
                    <Label Text="{Binding Error}" FontSize="12"
                           TextColor="{AppThemeBinding Light={StaticResource Danger}, Dark={StaticResource DangerDark}}" />
                </Border>

                <Border IsVisible="{Binding HasInfo}"
                        BackgroundColor="{AppThemeBinding Light=#E6F4EA, Dark=#1F3A28}"
                        Stroke="{AppThemeBinding Light=#B7DFC2, Dark=#356241}"
                        StrokeThickness="1" Padding="12,10" StrokeShape="RoundRectangle 6">
                    <Label Text="{Binding Info}" FontSize="12"
                           TextColor="{AppThemeBinding Light={StaticResource Success}, Dark={StaticResource SuccessDark}}" />
                </Border>

                <VerticalStackLayout Spacing="5">
                    <Label Text="Organization URL" Style="{StaticResource Caption}" />
                    <Border Style="{StaticResource FieldBorder}">
                        <Entry Text="{Binding Endpoint}" Placeholder="https://dev.azure.com/your-org" />
                    </Border>
                </VerticalStackLayout>

                <VerticalStackLayout Spacing="5">
                    <Label Text="Personal access token (leave blank to keep the existing one)" Style="{StaticResource Caption}" />
                    <Border Style="{StaticResource FieldBorder}">
                        <Entry Text="{Binding Token}" IsPassword="True" />
                    </Border>
                </VerticalStackLayout>

                <BoxView HeightRequest="1" Color="{AppThemeBinding Light={StaticResource StrokeLight}, Dark={StaticResource StrokeDark}}" />
                <Label Text="AWX automation repo (optional)" Style="{StaticResource Caption}" FontFamily="{StaticResource FontSemibold}" />
                <Label Text="Locates the blueprint manifest Iris compares against AWX's real Job Templates to detect drift." Style="{StaticResource Caption}" />

                <Grid ColumnDefinitions="1*,1*" ColumnSpacing="10">
                    <VerticalStackLayout Spacing="5">
                        <Label Text="Project" Style="{StaticResource Caption}" />
                        <Border Style="{StaticResource FieldBorder}">
                            <Entry Text="{Binding Project}" />
                        </Border>
                    </VerticalStackLayout>
                    <VerticalStackLayout Grid.Column="1" Spacing="5">
                        <Label Text="Repository" Style="{StaticResource Caption}" />
                        <Border Style="{StaticResource FieldBorder}">
                            <Entry Text="{Binding Repository}" Placeholder="awx" />
                        </Border>
                    </VerticalStackLayout>
                </Grid>

                <Grid ColumnDefinitions="1*,1*" ColumnSpacing="10">
                    <VerticalStackLayout Spacing="5">
                        <Label Text="Branch" Style="{StaticResource Caption}" />
                        <Border Style="{StaticResource FieldBorder}">
                            <Entry Text="{Binding Branch}" Placeholder="master" />
                        </Border>
                    </VerticalStackLayout>
                    <VerticalStackLayout Grid.Column="1" Spacing="5">
                        <Label Text="Manifest path" Style="{StaticResource Caption}" />
                        <Border Style="{StaticResource FieldBorder}">
                            <Entry Text="{Binding ManifestPath}" Placeholder="automation/manifests/awx_context_blueprints.yml" />
                        </Border>
                    </VerticalStackLayout>
                </Grid>
            </VerticalStackLayout>
        </ScrollView>

        <Grid Grid.Row="1" ColumnDefinitions="Auto,*,Auto,Auto,Auto" ColumnSpacing="10" Padding="22,12"
              BackgroundColor="{AppThemeBinding Light={StaticResource LayerLight}, Dark={StaticResource LayerDark}}">
            <ActivityIndicator IsRunning="{Binding IsBusy}" IsVisible="{Binding IsBusy}" VerticalOptions="Center" />
            <Label Grid.Column="1" Text="Test the connection before saving." Style="{StaticResource Caption}" VerticalOptions="Center" />
            <Button Grid.Column="2" Text="Cancel" Style="{StaticResource SecondaryButton}" HorizontalOptions="End" Clicked="OnCancel" />
            <Button Grid.Column="3" Text="Test connection" Style="{StaticResource SecondaryButton}" Command="{Binding TestConnectionCommand}" />
            <Button Grid.Column="4" Text="Save" Command="{Binding SaveCommand}" />
        </Grid>
    </Grid>
</ContentPage>
