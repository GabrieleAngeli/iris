<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    x:Class="Iris.App.Views.Dialogs.ConfigureAwxDialog"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:vm="clr-namespace:Iris.App.ViewModels"
    x:DataType="vm:ConfigureAwxDialogViewModel"
    Title="Configure AWX">

    <Grid RowDefinitions="*,Auto"
          BackgroundColor="{AppThemeBinding Light={StaticResource AppBackgroundLight}, Dark={StaticResource AppBackgroundDark}}">

        <ScrollView>
            <VerticalStackLayout Padding="22" Spacing="14">
                <VerticalStackLayout Spacing="4">
                    <Label Text="Configure AWX" Style="{StaticResource Subtitle}" />
                    <Label Text="Point Iris at an AWX instance you already have. Leave the token blank to keep the one already saved." Style="{StaticResource Caption}" />
                </VerticalStackLayout>

                <Border IsVisible="{Binding HasError}"
                        BackgroundColor="{AppThemeBinding Light=#FDE7E9, Dark=#442726}"
                        Stroke="{AppThemeBinding Light=#F1BBBB, Dark=#7A3B38}"
                        StrokeThickness="1"
                        Padding="12,10"
                        StrokeShape="RoundRectangle 6">
                    <Label Text="{Binding Error}" FontSize="12"
                           TextColor="{AppThemeBinding Light={StaticResource Danger}, Dark={StaticResource DangerDark}}" />
                </Border>

                <Border IsVisible="{Binding HasInfo}"
                        BackgroundColor="{AppThemeBinding Light=#E6F4EA, Dark=#1F3A28}"
                        Stroke="{AppThemeBinding Light=#B7DFC2, Dark=#356241}"
                        StrokeThickness="1" Padding="12,10" StrokeShape="RoundRectangle 6">
                    <Label Text="{Binding Info}" FontSize="12"
                           TextColor="{AppThemeBinding Light={StaticResource Success}, Dark={StaticResource SuccessDark}}" />
                </Border>

                <VerticalStackLayout Spacing="5">
                    <Label Text="Endpoint" Style="{StaticResource Caption}" />
                    <Border Style="{StaticResource FieldBorder}">
                        <Entry Text="{Binding Endpoint}" Placeholder="https://awx.internal" />
                    </Border>
                </VerticalStackLayout>

                <VerticalStackLayout Spacing="5">
                    <Label Text="Token (leave blank to keep the existing one)" Style="{StaticResource Caption}" />
                    <Border Style="{StaticResource FieldBorder}">
                        <Entry Text="{Binding Token}" IsPassword="True" />
                    </Border>
                </VerticalStackLayout>

                <VerticalStackLayout Spacing="5">
                    <Grid ColumnDefinitions="*,Auto">
                        <Label Text="Job templates declared in the AWX blueprint repo" Style="{StaticResource Caption}" />
                        <ActivityIndicator Grid.Column="1" IsRunning="{Binding IsLoadingTemplates}" IsVisible="{Binding IsLoadingTemplates}" WidthRequest="16" HeightRequest="16" />
                    </Grid>
                    <Label Text="{Binding TemplatesError}" IsVisible="{Binding HasTemplatesError}" Style="{StaticResource Caption}"
                           TextColor="{AppThemeBinding Light={StaticResource Danger}, Dark={StaticResource DangerDark}}" />
                    <Grid ColumnDefinitions="1*,1*" ColumnSpacing="10" IsVisible="{Binding HasTemplates}">
                        <VerticalStackLayout Spacing="5">
                            <Label Text="Pick deploy template" Style="{StaticResource Caption}" />
                            <Border Style="{StaticResource FieldBorder}">
                                <Picker ItemsSource="{Binding Templates}" ItemDisplayBinding="{Binding DisplayName}"
                                        SelectedItem="{Binding SelectedDeployTemplate}" />
                            </Border>
                        </VerticalStackLayout>
                        <VerticalStackLayout Grid.Column="1" Spacing="5">
                            <Label Text="Pick facts template" Style="{StaticResource Caption}" />
                            <Border Style="{StaticResource FieldBorder}">
                                <Picker ItemsSource="{Binding Templates}" ItemDisplayBinding="{Binding DisplayName}"
                                        SelectedItem="{Binding SelectedFactsTemplate}" />
                            </Border>
                        </VerticalStackLayout>
                    </Grid>
                </VerticalStackLayout>

                <Grid ColumnDefinitions="1*,1*" ColumnSpacing="10">
                    <VerticalStackLayout Spacing="5">
                        <Label Text="Job template id (deploy)" Style="{StaticResource Caption}" />
                        <Border Style="{StaticResource FieldBorder}">
                            <Entry Text="{Binding JobTemplateId}" Keyboard="Numeric" Placeholder="1" />
                        </Border>
                    </VerticalStackLayout>
                    <VerticalStackLayout Grid.Column="1" Spacing="5">
                        <Label Text="Job template id (facts / discovery)" Style="{StaticResource Caption}" />
                        <Border Style="{StaticResource FieldBorder}">
                            <Entry Text="{Binding FactsJobTemplateId}" Keyboard="Numeric" Placeholder="2" />
                        </Border>
                    </VerticalStackLayout>
                </Grid>

                <Label Text="The facts job template must be a separate Job Template with 'use_fact_cache' enabled — it gathers server inventory (CPU/RAM/disks), it does not deploy anything. Picking from the lists above fills the ids in for you; you can still type them by hand if the blueprint repo isn't reachable yet." Style="{StaticResource Caption}" />

                <BoxView HeightRequest="1" Color="{AppThemeBinding Light={StaticResource StrokeLight}, Dark={StaticResource StrokeDark}}" />
                <Label Text="OAuth2 auto-renew (optional)" Style="{StaticResource Caption}" FontFamily="{StaticResource FontSemibold}" />
                <Label Text="AWX access tokens expire. Fill the OAuth2 Application client id and a refresh token to let Iris renew the token automatically. The client secret is only for a Confidential application — leave it blank for a Public one. Leave the two secret fields blank to keep what's already saved." Style="{StaticResource Caption}" />

                <VerticalStackLayout Spacing="5">
                    <Label Text="OAuth2 client id" Style="{StaticResource Caption}" />
                    <Border Style="{StaticResource FieldBorder}">
                        <Entry Text="{Binding OAuthClientId}" />
                    </Border>
                </VerticalStackLayout>
                <Grid ColumnDefinitions="1*,1*" ColumnSpacing="10">
                    <VerticalStackLayout Spacing="5">
                        <Label Text="OAuth2 client secret" Style="{StaticResource Caption}" />
                        <Border Style="{StaticResource FieldBorder}">
                            <Entry Text="{Binding OAuthClientSecret}" IsPassword="True" />
                        </Border>
                    </VerticalStackLayout>
                    <VerticalStackLayout Grid.Column="1" Spacing="5">
                        <Label Text="Refresh token" Style="{StaticResource Caption}" />
                        <Border Style="{StaticResource FieldBorder}">
                            <Entry Text="{Binding RefreshToken}" IsPassword="True" />
                        </Border>
                    </VerticalStackLayout>
                </Grid>
            </VerticalStackLayout>
        </ScrollView>

        <Grid Grid.Row="1" ColumnDefinitions="Auto,*,Auto,Auto,Auto" ColumnSpacing="10" Padding="22,12"
              BackgroundColor="{AppThemeBinding Light={StaticResource LayerLight}, Dark={StaticResource LayerDark}}">
            <ActivityIndicator IsRunning="{Binding IsBusy}" IsVisible="{Binding IsBusy}" VerticalOptions="Center" />
            <Label Grid.Column="1" Text="Test the connection before saving." Style="{StaticResource Caption}" VerticalOptions="Center" />
            <Button Grid.Column="2" Text="Cancel" Style="{StaticResource SecondaryButton}" HorizontalOptions="End" Clicked="OnCancel" />
            <Button Grid.Column="3" Text="Test connection" Style="{StaticResource SecondaryButton}" Command="{Binding TestConnectionCommand}" />
            <Button Grid.Column="4" Text="Save" Command="{Binding SaveCommand}" />
        </Grid>
    </Grid>
</ContentPage>
