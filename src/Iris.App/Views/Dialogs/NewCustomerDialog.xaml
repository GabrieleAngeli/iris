<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    x:Class="Iris.App.Views.Dialogs.NewCustomerDialog"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:vm="clr-namespace:Iris.App.ViewModels"
    x:DataType="vm:CustomersViewModel"
    Title="New customer">

    <Grid RowDefinitions="*,Auto"
          BackgroundColor="{AppThemeBinding Light={StaticResource AppBackgroundLight}, Dark={StaticResource AppBackgroundDark}}">

        <ScrollView>
            <VerticalStackLayout Padding="22" Spacing="10">
                <Label Text="Register a customer tenant, then add its environments (Test / Staging / Production)." Style="{StaticResource Caption}" />

                <VerticalStackLayout Spacing="4">
                    <Label Text="Key" Style="{StaticResource Caption}" />
                    <Border Style="{StaticResource FieldBorder}">
                        <Entry Text="{Binding NewCustomerKey}" Placeholder="contoso" />
                    </Border>
                    <Label Text="Short, lowercase, unique — used in URLs and scopes." Style="{StaticResource Caption}" />
                </VerticalStackLayout>

                <VerticalStackLayout Spacing="4">
                    <Label Text="Display name" Style="{StaticResource Caption}" />
                    <Border Style="{StaticResource FieldBorder}">
                        <Entry Text="{Binding NewCustomerName}" Placeholder="Contoso Ltd" />
                    </Border>
                </VerticalStackLayout>

                <Label Text="{Binding CreateCustomerError}" IsVisible="{Binding HasCreateCustomerError}" FontSize="12"
                       TextColor="{AppThemeBinding Light={StaticResource Danger}, Dark={StaticResource DangerDark}}" />
            </VerticalStackLayout>
        </ScrollView>

        <Grid Grid.Row="1" ColumnDefinitions="*,Auto,Auto" ColumnSpacing="10" Padding="22,12"
              BackgroundColor="{AppThemeBinding Light={StaticResource LayerLight}, Dark={StaticResource LayerDark}}">
            <ActivityIndicator IsRunning="{Binding IsCreatingCustomer}" IsVisible="{Binding IsCreatingCustomer}" HorizontalOptions="Start" />
            <Button Grid.Column="1" Text="Cancel" Style="{StaticResource SecondaryButton}" Clicked="OnCancel" />
            <Button Grid.Column="2" Text="Create" Command="{Binding CreateCustomerCommand}"
                    IsEnabled="{Binding IsCreatingCustomer, Converter={StaticResource InvertBoolConverter}}" />
        </Grid>
    </Grid>
</ContentPage>
