<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    x:Class="Iris.App.Views.Dialogs.ConfigureOpsHostDialog"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:vm="clr-namespace:Iris.App.ViewModels"
    x:DataType="vm:ConfigureOpsHostDialogViewModel"
    Title="Configure ops host">

    <Grid RowDefinitions="*,Auto"
          BackgroundColor="{AppThemeBinding Light={StaticResource AppBackgroundLight}, Dark={StaticResource AppBackgroundDark}}">

        <ScrollView>
            <VerticalStackLayout Padding="22" Spacing="14">
                <VerticalStackLayout Spacing="4">
                    <Label Text="Configure ops host" Style="{StaticResource Subtitle}" />
                    <Label Text="The SSH target Iris connects to in order to run the AWX automation repo's blueprint-sync playbook — exactly what an operator would run by hand. Leave the credential blank to keep the one already saved." Style="{StaticResource Caption}" />
                </VerticalStackLayout>

                <Border IsVisible="{Binding HasError}"
                        BackgroundColor="{AppThemeBinding Light=#FDE7E9, Dark=#442726}"
                        Stroke="{AppThemeBinding Light=#F1BBBB, Dark=#7A3B38}"
                        StrokeThickness="1"
                        Padding="12,10"
                        StrokeShape="RoundRectangle 6">
                    <Label Text="{Binding Error}" FontSize="12"
                           TextColor="{AppThemeBinding Light={StaticResource Danger}, Dark={StaticResource DangerDark}}" />
                </Border>

                <Border IsVisible="{Binding HasInfo}"
                        BackgroundColor="{AppThemeBinding Light=#E6F4EA, Dark=#1F3A28}"
                        Stroke="{AppThemeBinding Light=#B7DFC2, Dark=#356241}"
                        StrokeThickness="1" Padding="12,10" StrokeShape="RoundRectangle 6">
                    <Label Text="{Binding Info}" FontSize="12"
                           TextColor="{AppThemeBinding Light={StaticResource Success}, Dark={StaticResource SuccessDark}}" />
                </Border>

                <Grid ColumnDefinitions="2*,1*" ColumnSpacing="10">
                    <VerticalStackLayout Spacing="5">
                        <Label Text="Host" Style="{StaticResource Caption}" />
                        <Border Style="{StaticResource FieldBorder}">
                            <Entry Text="{Binding Endpoint}" Placeholder="opsserver.internal" />
                        </Border>
                    </VerticalStackLayout>
                    <VerticalStackLayout Grid.Column="1" Spacing="5">
                        <Label Text="Port" Style="{StaticResource Caption}" />
                        <Border Style="{StaticResource FieldBorder}">
                            <Entry Text="{Binding Port}" Keyboard="Numeric" />
                        </Border>
                    </VerticalStackLayout>
                </Grid>

                <Grid ColumnDefinitions="1*,1*" ColumnSpacing="10">
                    <VerticalStackLayout Spacing="5">
                        <Label Text="Username" Style="{StaticResource Caption}" />
                        <Border Style="{StaticResource FieldBorder}">
                            <Entry Text="{Binding Username}" Placeholder="ops" />
                        </Border>
                    </VerticalStackLayout>
                    <VerticalStackLayout Grid.Column="1" Spacing="5">
                        <Label Text="Auth method" Style="{StaticResource Caption}" />
                        <Border Style="{StaticResource FieldBorder}">
                            <Picker ItemsSource="{Binding AuthMethods}" SelectedItem="{Binding AuthMethod}" />
                        </Border>
                    </VerticalStackLayout>
                </Grid>

                <VerticalStackLayout Spacing="5">
                    <Label Text="Password or private key (leave blank to keep the existing one)" Style="{StaticResource Caption}" />
                    <Border Style="{StaticResource FieldBorder}">
                        <Entry Text="{Binding Secret}" IsPassword="True" />
                    </Border>
                </VerticalStackLayout>

                <VerticalStackLayout Spacing="5">
                    <Label Text="AWX repo path on the ops host" Style="{StaticResource Caption}" />
                    <Border Style="{StaticResource FieldBorder}">
                        <Entry Text="{Binding RepoPath}" Placeholder="/home/ops/Refactoring_ops_flow/awx" />
                    </Border>
                </VerticalStackLayout>
            </VerticalStackLayout>
        </ScrollView>

        <Grid Grid.Row="1" ColumnDefinitions="Auto,*,Auto,Auto,Auto" ColumnSpacing="10" Padding="22,12"
              BackgroundColor="{AppThemeBinding Light={StaticResource LayerLight}, Dark={StaticResource LayerDark}}">
            <ActivityIndicator IsRunning="{Binding IsBusy}" IsVisible="{Binding IsBusy}" VerticalOptions="Center" />
            <Label Grid.Column="1" Text="Test the connection before saving." Style="{StaticResource Caption}" VerticalOptions="Center" />
            <Button Grid.Column="2" Text="Cancel" Style="{StaticResource SecondaryButton}" HorizontalOptions="End" Clicked="OnCancel" />
            <Button Grid.Column="3" Text="Test connection" Style="{StaticResource SecondaryButton}" Command="{Binding TestConnectionCommand}" />
            <Button Grid.Column="4" Text="Save" Command="{Binding SaveCommand}" />
        </Grid>
    </Grid>
</ContentPage>
