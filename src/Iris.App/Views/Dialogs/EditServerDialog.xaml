<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    x:Class="Iris.App.Views.Dialogs.EditServerDialog"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:vm="clr-namespace:Iris.App.ViewModels"
    x:DataType="vm:ServerRowViewModel"
    Title="Edit server">

    <Grid RowDefinitions="*,Auto"
          BackgroundColor="{AppThemeBinding Light={StaticResource AppBackgroundLight}, Dark={StaticResource AppBackgroundDark}}">

        <ScrollView>
            <VerticalStackLayout Padding="22" Spacing="10">

                <Grid ColumnDefinitions="*,*" ColumnSpacing="10">
                    <VerticalStackLayout Spacing="4">
                        <Label Text="Name" Style="{StaticResource Caption}" />
                        <Border Style="{StaticResource FieldBorder}">
                            <Entry Text="{Binding EditName}" Placeholder="web-01" />
                        </Border>
                    </VerticalStackLayout>
                    <VerticalStackLayout Grid.Column="1" Spacing="4">
                        <Label Text="Hostname / FQDN" Style="{StaticResource Caption}" />
                        <Border Style="{StaticResource FieldBorder}">
                            <Entry Text="{Binding EditHostname}" Placeholder="web-01.contoso.internal" />
                        </Border>
                    </VerticalStackLayout>
                </Grid>

                <Grid ColumnDefinitions="*,*,*" ColumnSpacing="10">
                    <VerticalStackLayout Spacing="4">
                        <Label Text="OS" Style="{StaticResource Caption}" />
                        <Picker ItemsSource="{Binding OsOptions}" SelectedItem="{Binding EditOs}" />
                    </VerticalStackLayout>
                    <VerticalStackLayout Grid.Column="1" Spacing="4">
                        <Label Text="Hosting" Style="{StaticResource Caption}" />
                        <Picker ItemsSource="{Binding HostingTypeOptions}" SelectedItem="{Binding EditHostingType}" />
                    </VerticalStackLayout>
                    <VerticalStackLayout Grid.Column="2" Spacing="4">
                        <Label Text="Environment" Style="{StaticResource Caption}" />
                        <Picker ItemsSource="{Binding EnvironmentOptions}" SelectedItem="{Binding EditEnvironment}" />
                    </VerticalStackLayout>
                </Grid>

                <Grid ColumnDefinitions="*,*" ColumnSpacing="10">
                    <VerticalStackLayout Spacing="4">
                        <Label Text="Public IP" Style="{StaticResource Caption}" />
                        <Border Style="{StaticResource FieldBorder}">
                            <Entry Text="{Binding EditPublicIp}" Placeholder="203.0.113.10" />
                        </Border>
                    </VerticalStackLayout>
                    <VerticalStackLayout Grid.Column="1" Spacing="4">
                        <Label Text="Private IP" Style="{StaticResource Caption}" />
                        <Border Style="{StaticResource FieldBorder}">
                            <Entry Text="{Binding EditPrivateIp}" Placeholder="10.0.4.12" />
                        </Border>
                    </VerticalStackLayout>
                </Grid>
                <Label Text="At least one of the two IPs is required." Style="{StaticResource Caption}" />

                <BoxView HeightRequest="1" Margin="0,6"
                         Color="{AppThemeBinding Light={StaticResource StrokeLight}, Dark={StaticResource StrokeDark}}" />

                <Label Text="Capacity" Style="{StaticResource Subtitle}" FontSize="15" />

                <Grid ColumnDefinitions="*,*,*" ColumnSpacing="10">
                    <VerticalStackLayout Spacing="4">
                        <Label Text="CPU cores" Style="{StaticResource Caption}" />
                        <Border Style="{StaticResource FieldBorder}">
                            <Entry Text="{Binding EditCpuCores}" Keyboard="Numeric" Placeholder="4" />
                        </Border>
                    </VerticalStackLayout>
                    <VerticalStackLayout Grid.Column="1" Spacing="4">
                        <Label Text="Memory MB" Style="{StaticResource Caption}" />
                        <Border Style="{StaticResource FieldBorder}">
                            <Entry Text="{Binding EditMemoryMb}" Keyboard="Numeric" Placeholder="8192" />
                        </Border>
                    </VerticalStackLayout>
                    <VerticalStackLayout Grid.Column="2" Spacing="4">
                        <Label Text="Total disk GB" Style="{StaticResource Caption}" />
                        <Border Style="{StaticResource FieldBorder}">
                            <Entry Text="{Binding EditDiskGb}" Keyboard="Numeric" Placeholder="250" />
                        </Border>
                    </VerticalStackLayout>
                </Grid>

                <Grid ColumnDefinitions="*,*" ColumnSpacing="10">
                    <VerticalStackLayout Spacing="4">
                        <Label Text="Application disk GB" Style="{StaticResource Caption}" />
                        <Border Style="{StaticResource FieldBorder}">
                            <Entry Text="{Binding EditApplicationDiskGb}" Keyboard="Numeric" Placeholder="150" />
                        </Border>
                    </VerticalStackLayout>
                    <VerticalStackLayout Grid.Column="1" Spacing="4">
                        <Label Text="Backup disk GB" Style="{StaticResource Caption}" />
                        <Border Style="{StaticResource FieldBorder}">
                            <Entry Text="{Binding EditBackupDiskGb}" Keyboard="Numeric" Placeholder="80" />
                        </Border>
                    </VerticalStackLayout>
                </Grid>

                <VerticalStackLayout Spacing="4">
                    <Label Text="Known used ports" Style="{StaticResource Caption}" />
                    <Border Style="{StaticResource FieldBorder}">
                        <Entry Text="{Binding EditUsedPorts}" Placeholder="22, 80, 443" />
                    </Border>
                </VerticalStackLayout>

                <Label Text="{Binding EditError}" IsVisible="{Binding HasEditError}" FontSize="12"
                       TextColor="{AppThemeBinding Light={StaticResource Danger}, Dark={StaticResource DangerDark}}" />

                <!-- ===== Delete ===== -->
                <BoxView HeightRequest="1" Margin="0,10,0,0"
                         Color="{AppThemeBinding Light={StaticResource StrokeLight}, Dark={StaticResource StrokeDark}}" />
                <Button Text="Delete this server…" Command="{Binding RequestDeleteCommand}"
                        Style="{StaticResource LinkButton}" HorizontalOptions="Start"
                        TextColor="{AppThemeBinding Light={StaticResource Danger}, Dark={StaticResource DangerDark}}" />
            </VerticalStackLayout>
        </ScrollView>

        <Grid Grid.Row="1" ColumnDefinitions="*,Auto,Auto" ColumnSpacing="10" Padding="22,12"
              BackgroundColor="{AppThemeBinding Light={StaticResource LayerLight}, Dark={StaticResource LayerDark}}">
            <ActivityIndicator IsRunning="{Binding IsEditBusy}" IsVisible="{Binding IsEditBusy}" HorizontalOptions="Start" />
            <Button Grid.Column="1" Text="Cancel" Style="{StaticResource SecondaryButton}" Clicked="OnCancel" />
            <Button Grid.Column="2" Text="Save" Command="{Binding SaveEditCommand}"
                    IsEnabled="{Binding IsEditBusy, Converter={StaticResource InvertBoolConverter}}" />
        </Grid>
    </Grid>
</ContentPage>
