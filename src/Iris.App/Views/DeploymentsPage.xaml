<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    x:Class="Iris.App.Views.DeploymentsPage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:vm="clr-namespace:Iris.App.ViewModels"
    xmlns:controls="clr-namespace:Iris.App.Controls"
    xmlns:toolkit="http://schemas.microsoft.com/dotnet/2022/maui/toolkit"
    x:DataType="vm:DeploymentsViewModel"
    Title="Deployments">

    <Grid>
        <ScrollView>
            <VerticalStackLayout Padding="28" Spacing="18" MaximumWidthRequest="1080" HorizontalOptions="Fill">

                <Grid ColumnDefinitions="*,Auto,Auto" ColumnSpacing="10">
                    <VerticalStackLayout Spacing="4">
                        <Label Text="Deployments" Style="{StaticResource TitleLarge}" />
                        <Label Text="This application, for this customer's environment, on this server — grouped by customer." Style="{StaticResource Caption}" />
                    </VerticalStackLayout>

                    <Button Grid.Column="1" Text="&#xE72C;  Refresh" FontFamily="{StaticResource FontIcons}"
                            Style="{StaticResource SecondaryButton}" Command="{Binding RefreshCommand}" VerticalOptions="Start" />
                    <Button Grid.Column="2" Text="New deployment" Command="{Binding RequestNewDeploymentCommand}"
                            IsVisible="{Binding CanManageDeployments}" VerticalOptions="Start" />
                </Grid>

                <Border IsVisible="{Binding HasError}"
                        BackgroundColor="{AppThemeBinding Light=#FDE7E9, Dark=#442726}"
                        Stroke="{AppThemeBinding Light=#F1BBBB, Dark=#7A3B38}"
                        StrokeThickness="1" Padding="12,10" StrokeShape="RoundRectangle 6">
                    <Label Text="{Binding Error}" FontSize="13"
                           TextColor="{AppThemeBinding Light={StaticResource Danger}, Dark={StaticResource DangerDark}}" />
                </Border>

                <VerticalStackLayout Spacing="14" BindableLayout.ItemsSource="{Binding CustomerGroups}">
                    <BindableLayout.ItemTemplate>
                        <DataTemplate x:DataType="vm:DeploymentCustomerGroupViewModel">
                            <Border Style="{StaticResource Card}">
                                <toolkit:Expander IsExpanded="True">
                                    <toolkit:Expander.Header>
                                        <Grid ColumnDefinitions="*,Auto">
                                            <HorizontalStackLayout Spacing="8">
                                                <Label Text="{Binding Name}" FontFamily="{StaticResource FontSemibold}" FontSize="16" />
                                                <Border Style="{StaticResource Badge}" IsVisible="{Binding IsActive, Converter={StaticResource InvertBoolConverter}}">
                                                    <Label Text="Inactive" Style="{StaticResource Caption}" />
                                                </Border>
                                            </HorizontalStackLayout>
                                            <Label Grid.Column="1" Text="&#xE70D;" FontFamily="{StaticResource FontIcons}" FontSize="12" VerticalOptions="Center" />
                                        </Grid>
                                    </toolkit:Expander.Header>

                                    <VerticalStackLayout Spacing="10" Padding="0,14,0,0" BindableLayout.ItemsSource="{Binding Contexts}">
                                        <BindableLayout.ItemTemplate>
                                            <DataTemplate x:DataType="vm:DeploymentContextGroupViewModel">
                                                <Border BackgroundColor="{AppThemeBinding Light={StaticResource LayerAltLight}, Dark={StaticResource LayerAltDark}}"
                                                        Stroke="{AppThemeBinding Light={StaticResource StrokeLight}, Dark={StaticResource StrokeDark}}"
                                                        StrokeThickness="1" Padding="12" StrokeShape="RoundRectangle 6">
                                                    <VerticalStackLayout Spacing="10">
                                                        <HorizontalStackLayout Spacing="8">
                                                            <Label Text="{Binding Name}" FontFamily="{StaticResource FontSemibold}" FontSize="13" />
                                                            <Border Style="{StaticResource Badge}">
                                                                <Label Text="{Binding Kind}" Style="{StaticResource Caption}" />
                                                            </Border>
                                                            <Border Style="{StaticResource Badge}" IsVisible="{Binding IsActive, Converter={StaticResource InvertBoolConverter}}">
                                                                <Label Text="Inactive" Style="{StaticResource Caption}" />
                                                            </Border>
                                                        </HorizontalStackLayout>

                                                        <Grid ColumnDefinitions="*,Auto" RowDefinitions="40" ColumnSpacing="8"
                                                              IsVisible="{Binding CanManageDeployments}">
                                                            <Border Grid.Row="0" Grid.Column="0" Style="{StaticResource FieldBorder}"
                                                                    IsVisible="{Binding HasAvailableServers}"
                                                                    HorizontalOptions="Fill" VerticalOptions="Fill" HeightRequest="40">
                                                                <Picker ItemsSource="{Binding AvailableServers}" SelectedItem="{Binding SelectedServerToAssign}"
                                                                        Title="Assign a server" HorizontalOptions="Fill" VerticalOptions="Center">
                                                                    <Picker.ItemDisplayBinding>
                                                                        <Binding Path="DisplayName" x:DataType="vm:ServerOptionViewModel" />
                                                                    </Picker.ItemDisplayBinding>
                                                                </Picker>
                                                            </Border>
                                                            <Label Grid.Row="0" Grid.Column="0" Text="No more active servers available to assign." Style="{StaticResource Caption}"
                                                                   IsVisible="{Binding HasAvailableServers, Converter={StaticResource InvertBoolConverter}}"
                                                                   LineBreakMode="TailTruncation" MaxLines="1"
                                                                   VerticalOptions="Center" />
                                                            <Button Grid.Row="0" Grid.Column="1" Text="Assign" Style="{StaticResource SecondaryButton}"
                                                                    Command="{Binding AssignServerCommand}"
                                                                    IsVisible="{Binding HasAvailableServers}"
                                                                    IsEnabled="{Binding IsAssigningServer, Converter={StaticResource InvertBoolConverter}}"
                                                                    HeightRequest="40" VerticalOptions="Fill" />
                                                        </Grid>
                                                        <Label Text="{Binding AssignServerError}" IsVisible="{Binding HasAssignServerError}" Style="{StaticResource Caption}"
                                                               TextColor="{AppThemeBinding Light={StaticResource Danger}, Dark={StaticResource DangerDark}}" />

                                                        <Label Text="No servers chosen for this environment yet." Style="{StaticResource Caption}"
                                                               IsVisible="{Binding HasServers, Converter={StaticResource InvertBoolConverter}}" />

                                                        <VerticalStackLayout Spacing="10" BindableLayout.ItemsSource="{Binding Servers}">
                                                            <BindableLayout.ItemTemplate>
                                                                <DataTemplate x:DataType="vm:DeploymentServerGroupViewModel">
                                                                    <VerticalStackLayout Spacing="6">
                                                                        <Grid ColumnDefinitions="Auto,*,Auto,Auto" ColumnSpacing="6">
                                                                            <Label Text="&#xE7F4;" FontFamily="{StaticResource FontIcons}" FontSize="12"
                                                                                   TextColor="{AppThemeBinding Light={StaticResource TextSecondaryLight}, Dark={StaticResource TextSecondaryDark}}"
                                                                                   VerticalOptions="Center" />
                                                                            <Label Grid.Column="1" Text="{Binding ServerName}" FontFamily="{StaticResource FontSemibold}" FontSize="12"
                                                                                   VerticalOptions="Center" />
                                                                            <Button Grid.Column="2" Text="+ Application" Style="{StaticResource SecondaryButton}"
                                                                                    Command="{Binding AddApplicationCommand}" IsVisible="{Binding CanManageDeployments}"
                                                                                    FontSize="12" Padding="10,4" HeightRequest="30" />
                                                                            <Button Grid.Column="3" Text="&#xE711;" FontFamily="{StaticResource FontIcons}"
                                                                                    Style="{StaticResource IconButton}" Command="{Binding UnassignCommand}"
                                                                                    IsVisible="{Binding CanManageDeployments}"
                                                                                    ToolTipProperties.Text="Unassign this server from the environment" />
                                                                        </Grid>

                                                                        <Label Text="No applications on this server yet." Style="{StaticResource Caption}"
                                                                               IsVisible="{Binding HasInstallations, Converter={StaticResource InvertBoolConverter}}" />

                                                                        <VerticalStackLayout Spacing="8" BindableLayout.ItemsSource="{Binding Installations}">
                                                                            <BindableLayout.ItemTemplate>
                                                                                <DataTemplate x:DataType="vm:ApplicationInstallationRowViewModel">
                                                                                    <Border BackgroundColor="{AppThemeBinding Light={StaticResource LayerLight}, Dark={StaticResource LayerDark}}"
                                                                                            Stroke="{AppThemeBinding Light={StaticResource StrokeLight}, Dark={StaticResource StrokeDark}}"
                                                                                            StrokeThickness="1" Padding="12" StrokeShape="RoundRectangle 6">
                                                                                        <Grid ColumnDefinitions="*,Auto" ColumnSpacing="10">
                                                                                            <VerticalStackLayout Spacing="3" VerticalOptions="Center">
                                                                                                <HorizontalStackLayout Spacing="8">
                                                                                                    <Label Text="{Binding Name}" FontFamily="{StaticResource FontSemibold}" FontSize="13"
                                                                                                           LineBreakMode="TailTruncation" />
                                                                                                    <Border Style="{StaticResource Badge}" IsVisible="{Binding IsActive, Converter={StaticResource InvertBoolConverter}}">
                                                                                                        <Label Text="Inactive" Style="{StaticResource Caption}" />
                                                                                                    </Border>
                                                                                                </HorizontalStackLayout>
                                                                                                <Label Text="{Binding DetailText}" Style="{StaticResource Caption}" LineBreakMode="TailTruncation" />
                                                                                            </VerticalStackLayout>
                                                                                            <Button Grid.Column="1" Text="Manage" Style="{StaticResource SecondaryButton}"
                                                                                                    Command="{Binding OpenOpsCommand}" VerticalOptions="Center" />
                                                                                        </Grid>
                                                                                    </Border>
                                                                                </DataTemplate>
                                                                            </BindableLayout.ItemTemplate>
                                                                        </VerticalStackLayout>
                                                                    </VerticalStackLayout>
                                                                </DataTemplate>
                                                            </BindableLayout.ItemTemplate>
                                                        </VerticalStackLayout>
                                                    </VerticalStackLayout>
                                                </Border>
                                            </DataTemplate>
                                        </BindableLayout.ItemTemplate>
                                    </VerticalStackLayout>
                                </toolkit:Expander>
                            </Border>
                        </DataTemplate>
                    </BindableLayout.ItemTemplate>
                </VerticalStackLayout>

            </VerticalStackLayout>
        </ScrollView>

        <controls:LoadingView IsActive="{Binding IsLoading}" Message="Loading deployments..." />
    </Grid>

</ContentPage>
