<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    x:Class="Iris.App.Views.ServersPage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:vm="clr-namespace:Iris.App.ViewModels"
    xmlns:controls="clr-namespace:Iris.App.Controls"
    x:DataType="vm:ServersViewModel"
    Title="Servers">

    <Grid>
        <ScrollView>
            <VerticalStackLayout Padding="28" Spacing="18" MaximumWidthRequest="1080" HorizontalOptions="Fill">

                <Grid ColumnDefinitions="*,Auto,Auto" ColumnSpacing="10">
                    <VerticalStackLayout Spacing="4">
                        <Label Text="Servers" Style="{StaticResource TitleLarge}" />
                        <Label Text="Registered infrastructure and the OS-login credentials each server holds." Style="{StaticResource Caption}" />
                    </VerticalStackLayout>
                    <Button Grid.Column="1" Text="&#xE72C;  Refresh" FontFamily="{StaticResource FontIcons}"
                            Style="{StaticResource SecondaryButton}" Command="{Binding RefreshCommand}" VerticalOptions="Start" />
                    <Button Grid.Column="2" Text="New server" Command="{Binding ToggleNewServerPanelCommand}" VerticalOptions="Start" />
                </Grid>

                <Border IsVisible="{Binding HasError}"
                        BackgroundColor="{AppThemeBinding Light=#FDE7E9, Dark=#442726}"
                        Stroke="{AppThemeBinding Light=#F1BBBB, Dark=#7A3B38}"
                        StrokeThickness="1" Padding="12,10" StrokeShape="RoundRectangle 6">
                    <Label Text="{Binding Error}" FontSize="13"
                           TextColor="{AppThemeBinding Light={StaticResource Danger}, Dark={StaticResource DangerDark}}" />
                </Border>

                <VerticalStackLayout Spacing="14" BindableLayout.ItemsSource="{Binding Servers}">
                    <BindableLayout.ItemTemplate>
                        <DataTemplate x:DataType="vm:ServerRowViewModel">
                            <Border Style="{StaticResource Card}">
                                <VerticalStackLayout Spacing="14">

                                    <!-- ===== Server header ===== -->
                                    <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="12">
                                        <Border WidthRequest="38" HeightRequest="38" StrokeThickness="0" StrokeShape="RoundRectangle 19"
                                                BackgroundColor="{AppThemeBinding Light={StaticResource Secondary}, Dark={StaticResource SubtleFillDark}}">
                                            <Label Text="&#xE7F4;" FontFamily="{StaticResource FontIcons}" FontSize="16"
                                                   HorizontalOptions="Center" VerticalOptions="Center"
                                                   TextColor="{AppThemeBinding Light={StaticResource AccentLight}, Dark={StaticResource AccentDark}}" />
                                        </Border>
                                        <VerticalStackLayout Grid.Column="1" Spacing="2" VerticalOptions="Center">
                                            <HorizontalStackLayout Spacing="8">
                                                <Label Text="{Binding Name}" FontFamily="{StaticResource FontSemibold}" FontSize="15" />
                                                <Border Style="{StaticResource Badge}"><Label Text="{Binding Os}" Style="{StaticResource Caption}" /></Border>
                                                <Border Style="{StaticResource Badge}"><Label Text="{Binding HostingType}" Style="{StaticResource Caption}" /></Border>
                                                <Border Style="{StaticResource Badge}"><Label Text="{Binding Environment}" Style="{StaticResource Caption}" /></Border>
                                            </HorizontalStackLayout>
                                            <Label Text="{Binding Hostname, TargetNullValue='(no hostname)'}" Style="{StaticResource Caption}" />
                                            <HorizontalStackLayout Spacing="14">
                                                <Label Text="{Binding PublicIpAddress, StringFormat='Public: {0}', TargetNullValue='Public: —'}" Style="{StaticResource Caption}" />
                                                <Label Text="{Binding PrivateIpAddress, StringFormat='Private: {0}', TargetNullValue='Private: —'}" Style="{StaticResource Caption}" />
                                            </HorizontalStackLayout>
                                        </VerticalStackLayout>
                                        <Button Grid.Column="2" Text="Add credential" Style="{StaticResource SecondaryButton}"
                                                Command="{Binding OpenAddCredentialCommand}" VerticalOptions="Center" />
                                    </Grid>

                                    <!-- ===== Current credentials ===== -->
                                    <VerticalStackLayout Spacing="0" BindableLayout.ItemsSource="{Binding Credentials}">
                                        <BindableLayout.ItemTemplate>
                                            <DataTemplate x:DataType="vm:CredentialRowViewModel">
                                                <Grid ColumnDefinitions="*,Auto" Padding="0,6" ColumnSpacing="8">
                                                    <HorizontalStackLayout Grid.Column="0" Spacing="8">
                                                        <VerticalStackLayout Spacing="0">
                                                            <Label Text="{Binding Username}" Style="{StaticResource Body}" FontAttributes="Bold" />
                                                            <Label Text="{Binding Detail}" Style="{StaticResource Caption}" />
                                                        </VerticalStackLayout>
                                                        <Border Style="{StaticResource Badge}" VerticalOptions="Center">
                                                            <Label Text="{Binding Kind}" Style="{StaticResource Caption}" />
                                                        </Border>
                                                        <Border Style="{StaticResource Badge}" VerticalOptions="Center">
                                                            <Label Text="{Binding AuthMethod}" Style="{StaticResource Caption}" />
                                                        </Border>
                                                    </HorizontalStackLayout>
                                                    <Button Grid.Column="1" Text="Revoke" Style="{StaticResource LinkButton}"
                                                            Command="{Binding Owner.RemoveCredentialCommand}" CommandParameter="{Binding .}" />
                                                </Grid>
                                            </DataTemplate>
                                        </BindableLayout.ItemTemplate>
                                    </VerticalStackLayout>

                                </VerticalStackLayout>
                            </Border>
                        </DataTemplate>
                    </BindableLayout.ItemTemplate>
                </VerticalStackLayout>

            </VerticalStackLayout>
        </ScrollView>

        <!-- ===== New server (modal) ===== -->
        <controls:ModalPanel IsOpen="{Binding IsNewServerPanelOpen}" HeaderText="New server"
                             CloseCommand="{Binding ToggleNewServerPanelCommand}">
            <VerticalStackLayout Spacing="10">
                <Label Text="Register a server, then add the OS-login credential(s) tooling will use to reach it." Style="{StaticResource Caption}" />

                <Grid ColumnDefinitions="*,*" ColumnSpacing="10">
                    <VerticalStackLayout Spacing="4">
                        <Label Text="Name" Style="{StaticResource Caption}" />
                        <Border Style="{StaticResource FieldBorder}">
                            <Entry Text="{Binding NewServerName}" Placeholder="web-01" />
                        </Border>
                    </VerticalStackLayout>
                    <VerticalStackLayout Grid.Column="1" Spacing="4">
                        <Label Text="Hostname / FQDN" Style="{StaticResource Caption}" />
                        <Border Style="{StaticResource FieldBorder}">
                            <Entry Text="{Binding NewServerHostname}" Placeholder="web-01.contoso.internal" />
                        </Border>
                    </VerticalStackLayout>
                </Grid>

                <Grid ColumnDefinitions="*,*,*" ColumnSpacing="10">
                    <VerticalStackLayout Spacing="4">
                        <Label Text="OS" Style="{StaticResource Caption}" />
                        <Picker ItemsSource="{Binding OsOptions}" SelectedItem="{Binding NewServerOs}" />
                    </VerticalStackLayout>
                    <VerticalStackLayout Grid.Column="1" Spacing="4">
                        <Label Text="Hosting" Style="{StaticResource Caption}" />
                        <Picker ItemsSource="{Binding HostingTypeOptions}" SelectedItem="{Binding NewServerHostingType}" />
                    </VerticalStackLayout>
                    <VerticalStackLayout Grid.Column="2" Spacing="4">
                        <Label Text="Environment" Style="{StaticResource Caption}" />
                        <Picker ItemsSource="{Binding EnvironmentOptions}" SelectedItem="{Binding NewServerEnvironment}" />
                    </VerticalStackLayout>
                </Grid>

                <Grid ColumnDefinitions="*,*" ColumnSpacing="10">
                    <VerticalStackLayout Spacing="4">
                        <Label Text="Public IP" Style="{StaticResource Caption}" />
                        <Border Style="{StaticResource FieldBorder}">
                            <Entry Text="{Binding NewServerPublicIp}" Placeholder="203.0.113.10" />
                        </Border>
                    </VerticalStackLayout>
                    <VerticalStackLayout Grid.Column="1" Spacing="4">
                        <Label Text="Private IP" Style="{StaticResource Caption}" />
                        <Border Style="{StaticResource FieldBorder}">
                            <Entry Text="{Binding NewServerPrivateIp}" Placeholder="10.0.4.12" />
                        </Border>
                    </VerticalStackLayout>
                </Grid>
                <Label Text="At least one of the two IPs is required." Style="{StaticResource Caption}" />

                <BoxView HeightRequest="1" Margin="0,4"
                         Color="{AppThemeBinding Light=#E6E1D6, Dark=#3A3A3A}" />
                <HorizontalStackLayout Spacing="8">
                    <CheckBox IsChecked="{Binding IncludeCredential}" VerticalOptions="Center" />
                    <Label Text="Add an OS-login credential now (username + password or SSH key)"
                           VerticalOptions="Center" Style="{StaticResource Caption}" />
                </HorizontalStackLayout>

                <VerticalStackLayout IsVisible="{Binding IncludeCredential}">
                    <VerticalStackLayout Spacing="10"
                                         BindingContext="{Binding NewServerCredential}"
                                         x:DataType="vm:CredentialFormViewModel">

                        <Grid ColumnDefinitions="*,*" ColumnSpacing="10">
                            <VerticalStackLayout Spacing="4">
                                <Label Text="Credential type" Style="{StaticResource Caption}" />
                                <Picker ItemsSource="{Binding KindOptions}" SelectedItem="{Binding Kind}" />
                            </VerticalStackLayout>
                            <VerticalStackLayout Grid.Column="1" Spacing="4">
                                <Label Text="Auth method" Style="{StaticResource Caption}" />
                                <Picker ItemsSource="{Binding AuthMethods}" SelectedItem="{Binding AuthMethod}" />
                            </VerticalStackLayout>
                        </Grid>

                        <Grid ColumnDefinitions="*,*" ColumnSpacing="10">
                            <VerticalStackLayout Spacing="4">
                                <Label Text="Username on the server" Style="{StaticResource Caption}" />
                                <Border Style="{StaticResource FieldBorder}">
                                    <Entry Text="{Binding Username}" Placeholder="root / deploy / ansible" />
                                </Border>
                            </VerticalStackLayout>
                            <VerticalStackLayout Grid.Column="1" Spacing="4" IsVisible="{Binding IsServiceAccount}">
                                <Label Text="Service name" Style="{StaticResource Caption}" />
                                <Border Style="{StaticResource FieldBorder}">
                                    <Entry Text="{Binding ServiceName}" Placeholder="ansible" />
                                </Border>
                            </VerticalStackLayout>
                            <VerticalStackLayout Grid.Column="1" Spacing="4" IsVisible="{Binding IsSystemUser}">
                                <Label Text="Linked Iris user (optional)" Style="{StaticResource Caption}" />
                                <Picker ItemsSource="{Binding OwnerOptions}" SelectedItem="{Binding SelectedOwner}" />
                            </VerticalStackLayout>
                        </Grid>

                        <VerticalStackLayout Spacing="4">
                            <Label Text="Password or SSH private key" Style="{StaticResource Caption}" />
                            <Border Style="{StaticResource FieldBorder}">
                                <Entry Text="{Binding SecretValue}" IsPassword="True" Placeholder="Stored in the secret store — never shown again" />
                            </Border>
                        </VerticalStackLayout>

                        <VerticalStackLayout Spacing="4">
                            <Label Text="Note (optional)" Style="{StaticResource Caption}" />
                            <Border Style="{StaticResource FieldBorder}">
                                <Entry Text="{Binding Label}" Placeholder="e.g. break-glass root access" />
                            </Border>
                        </VerticalStackLayout>

                    </VerticalStackLayout>
                </VerticalStackLayout>

                <Label Text="{Binding CreateServerError}" IsVisible="{Binding HasCreateServerError}" FontSize="12"
                       TextColor="{AppThemeBinding Light={StaticResource Danger}, Dark={StaticResource DangerDark}}" />

                <Grid>
                    <Button Text="Create" Command="{Binding CreateServerCommand}"
                            IsVisible="{Binding IsCreatingServer, Converter={StaticResource InvertBoolConverter}}"
                            HorizontalOptions="Start" />
                    <ActivityIndicator IsRunning="{Binding IsCreatingServer}" IsVisible="{Binding IsCreatingServer}" HorizontalOptions="Start" />
                </Grid>
            </VerticalStackLayout>
        </controls:ModalPanel>

        <!-- ===== Add credential (modal) ===== -->
        <controls:ModalPanel IsOpen="{Binding IsCredentialModalOpen}" HeaderText="Add credential"
                             CloseCommand="{Binding CloseCredentialPanelCommand}" CardWidth="600">
            <VerticalStackLayout Spacing="10"
                                 BindingContext="{Binding ActiveCredentialRow}"
                                 x:DataType="vm:ServerRowViewModel">

                <VerticalStackLayout Spacing="10"
                                     BindingContext="{Binding AddCredentialForm}"
                                     x:DataType="vm:CredentialFormViewModel">

                    <Grid ColumnDefinitions="*,*" ColumnSpacing="10">
                        <VerticalStackLayout Spacing="4">
                            <Label Text="Credential type" Style="{StaticResource Caption}" />
                            <Picker ItemsSource="{Binding KindOptions}" SelectedItem="{Binding Kind}" />
                        </VerticalStackLayout>
                        <VerticalStackLayout Grid.Column="1" Spacing="4">
                            <Label Text="Auth method" Style="{StaticResource Caption}" />
                            <Picker ItemsSource="{Binding AuthMethods}" SelectedItem="{Binding AuthMethod}" />
                        </VerticalStackLayout>
                    </Grid>

                    <Grid ColumnDefinitions="*,*" ColumnSpacing="10">
                        <VerticalStackLayout Spacing="4">
                            <Label Text="Username on the server" Style="{StaticResource Caption}" />
                            <Border Style="{StaticResource FieldBorder}">
                                <Entry Text="{Binding Username}" Placeholder="root / deploy / ansible" />
                            </Border>
                        </VerticalStackLayout>
                        <VerticalStackLayout Grid.Column="1" Spacing="4" IsVisible="{Binding IsServiceAccount}">
                            <Label Text="Service name" Style="{StaticResource Caption}" />
                            <Border Style="{StaticResource FieldBorder}">
                                <Entry Text="{Binding ServiceName}" Placeholder="ansible" />
                            </Border>
                        </VerticalStackLayout>
                        <VerticalStackLayout Grid.Column="1" Spacing="4" IsVisible="{Binding IsSystemUser}">
                            <Label Text="Linked Iris user (optional)" Style="{StaticResource Caption}" />
                            <Picker ItemsSource="{Binding OwnerOptions}" SelectedItem="{Binding SelectedOwner}" />
                        </VerticalStackLayout>
                    </Grid>

                    <VerticalStackLayout Spacing="4">
                        <Label Text="Password or SSH private key" Style="{StaticResource Caption}" />
                        <Border Style="{StaticResource FieldBorder}">
                            <Entry Text="{Binding SecretValue}" IsPassword="True" Placeholder="Stored in the secret store — never shown again" />
                        </Border>
                    </VerticalStackLayout>

                    <VerticalStackLayout Spacing="4">
                        <Label Text="Note (optional)" Style="{StaticResource Caption}" />
                        <Border Style="{StaticResource FieldBorder}">
                            <Entry Text="{Binding Label}" Placeholder="e.g. CI deploy account" />
                        </Border>
                    </VerticalStackLayout>

                </VerticalStackLayout>

                <Label Text="{Binding CredentialError}" IsVisible="{Binding HasCredentialError}" FontSize="12"
                       TextColor="{AppThemeBinding Light={StaticResource Danger}, Dark={StaticResource DangerDark}}" />

                <Grid>
                    <Button Text="Add" Command="{Binding AddCredentialCommand}"
                            IsVisible="{Binding IsBusy, Converter={StaticResource InvertBoolConverter}}"
                            HorizontalOptions="Start" />
                    <ActivityIndicator IsRunning="{Binding IsBusy}" IsVisible="{Binding IsBusy}" HorizontalOptions="Start" />
                </Grid>
            </VerticalStackLayout>
        </controls:ModalPanel>

        <controls:LoadingView IsActive="{Binding IsLoading}" Message="Loading servers…" />
    </Grid>

</ContentPage>
