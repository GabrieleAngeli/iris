<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    x:Class="Iris.App.Views.ActivityDetailPage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    Title="Activity">

    <ScrollView>
        <VerticalStackLayout Padding="28" Spacing="18" MaximumWidthRequest="640" HorizontalOptions="Start">

            <Border Style="{StaticResource Card}">
                <VerticalStackLayout Spacing="14">
                    <HorizontalStackLayout Spacing="12">
                        <Border WidthRequest="44" HeightRequest="44" StrokeThickness="0"
                                BackgroundColor="{AppThemeBinding Light={StaticResource Secondary}, Dark={StaticResource SubtleFillDark}}"
                                StrokeShape="RoundRectangle 22">
                            <Label Text="&#xE7C3;" FontFamily="{StaticResource FontIcons}" FontSize="18"
                                   HorizontalOptions="Center" VerticalOptions="Center"
                                   TextColor="{AppThemeBinding Light={StaticResource AccentLight}, Dark={StaticResource AccentDark}}" />
                        </Border>
                        <VerticalStackLayout VerticalOptions="Center">
                            <Label x:Name="TitleLabel" Style="{StaticResource Subtitle}" />
                            <Label x:Name="MetaLabel" Style="{StaticResource Caption}" />
                        </VerticalStackLayout>
                    </HorizontalStackLayout>

                    <BoxView HeightRequest="1" />

                    <Label x:Name="DescriptionLabel" Style="{StaticResource Body}" />

                    <Button Text="Back to dashboard" Style="{StaticResource SecondaryButton}"
                            HorizontalOptions="Start" Clicked="OnBackClicked" />
                </VerticalStackLayout>
            </Border>

        </VerticalStackLayout>
    </ScrollView>

</ContentPage>
