<?xml version="1.0" encoding="UTF-8" ?>
<Shell
    x:Class="Iris.App.AppShell"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:views="clr-namespace:Iris.App.Views"
    xmlns:vm="clr-namespace:Iris.App.ViewModels"
    x:DataType="vm:AppShellViewModel"
    Title="Iris"
    FlyoutBehavior="Flyout"
    FlyoutWidth="260">

    <Shell.FlyoutHeader>
        <VerticalStackLayout>
            <Grid Padding="20,28,20,20" ColumnDefinitions="Auto,*" ColumnSpacing="12"
                  BackgroundColor="{AppThemeBinding Light={StaticResource AccentLight}, Dark={StaticResource LayerDark}}">
                <Border WidthRequest="48" HeightRequest="48" StrokeThickness="0"
                        BackgroundColor="#F4F0E6"
                        StrokeShape="RoundRectangle 24">
                    <Image Source="iris_mark.png" WidthRequest="38" HeightRequest="38"
                           HorizontalOptions="Center" VerticalOptions="Center" />
                </Border>
                <VerticalStackLayout Grid.Column="1" Spacing="1" VerticalOptions="Center">
                    <Label Text="Iris" FontFamily="{StaticResource FontSemibold}" FontSize="17"
                           TextColor="{AppThemeBinding Light=White, Dark={StaticResource TextPrimaryDark}}" />
                    <Label Text="ICP - Infrastructure Control Plane" FontSize="12"
                           TextColor="{AppThemeBinding Light=#DCEBFF, Dark={StaticResource TextSecondaryDark}}" />
                </VerticalStackLayout>
            </Grid>

            <Grid Padding="20,14" ColumnDefinitions="Auto,*" RowDefinitions="Auto,Auto" ColumnSpacing="12" RowSpacing="8"
                  BackgroundColor="{AppThemeBinding Light={StaticResource LayerAltLight}, Dark={StaticResource LayerAltDark}}">
                <Border WidthRequest="36" HeightRequest="36" StrokeThickness="0"
                        BackgroundColor="{AppThemeBinding Light={StaticResource AccentLight}, Dark={StaticResource AccentDark}}"
                        StrokeShape="RoundRectangle 18">
                    <Label Text="{Binding Initials}" TextColor="White" FontFamily="{StaticResource FontSemibold}" FontSize="13"
                           HorizontalOptions="Center" VerticalOptions="Center" />
                </Border>
                <VerticalStackLayout Grid.Column="1" Spacing="0" VerticalOptions="Center">
                    <Label Text="{Binding DisplayName}" FontFamily="{StaticResource FontSemibold}" FontSize="13"
                           LineBreakMode="TailTruncation"
                           TextColor="{AppThemeBinding Light={StaticResource TextPrimaryLight}, Dark={StaticResource TextPrimaryDark}}" />
                    <Label Text="{Binding Email}" FontSize="11" LineBreakMode="TailTruncation"
                           TextColor="{AppThemeBinding Light={StaticResource TextSecondaryLight}, Dark={StaticResource TextSecondaryDark}}" />
                </VerticalStackLayout>
                <HorizontalStackLayout Grid.Row="1" Grid.Column="1" Spacing="12">
                    <Button Text="Profile" Style="{StaticResource LinkButton}"
                            Command="{Binding NavigateCommand}" CommandParameter="//profile" />
                    <Button Text="Sign out" Style="{StaticResource LinkButton}" Clicked="OnSignOutClicked" />
                </HorizontalStackLayout>
            </Grid>
        </VerticalStackLayout>
    </Shell.FlyoutHeader>

    <Shell.Resources>
        <Style x:Key="FlyoutRowButtonStyle" TargetType="Button">
            <Setter Property="BackgroundColor" Value="Transparent" />
            <Setter Property="TextColor" Value="Transparent" />
            <Setter Property="BorderWidth" Value="0" />
            <Setter Property="CornerRadius" Value="0" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="HorizontalOptions" Value="Fill" />
            <Setter Property="VerticalOptions" Value="Fill" />
        </Style>
        <Style x:Key="FlyoutSectionTextStyle" TargetType="Label">
            <Setter Property="FontFamily" Value="{StaticResource FontSemibold}" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="VerticalTextAlignment" Value="Center" />
            <Setter Property="TextColor" Value="{AppThemeBinding Light={StaticResource TextSecondaryLight}, Dark={StaticResource TextSecondaryDark}}" />
        </Style>
        <Style x:Key="FlyoutRowIconStyle" TargetType="Label">
            <Setter Property="FontFamily" Value="{StaticResource FontIcons}" />
            <Setter Property="FontSize" Value="16" />
            <Setter Property="WidthRequest" Value="22" />
            <Setter Property="HorizontalTextAlignment" Value="Center" />
            <Setter Property="VerticalTextAlignment" Value="Center" />
            <Setter Property="TextColor" Value="{AppThemeBinding Light={StaticResource AccentLight}, Dark={StaticResource AccentDark}}" />
        </Style>
        <Style x:Key="FlyoutChevronStyle" TargetType="Label">
            <Setter Property="FontFamily" Value="{StaticResource FontIcons}" />
            <Setter Property="FontSize" Value="11" />
            <Setter Property="WidthRequest" Value="18" />
            <Setter Property="HorizontalTextAlignment" Value="Center" />
            <Setter Property="VerticalTextAlignment" Value="Center" />
            <Setter Property="TextColor" Value="{AppThemeBinding Light={StaticResource TextSecondaryLight}, Dark={StaticResource TextSecondaryDark}}" />
        </Style>
        <Style x:Key="FlyoutRowTextStyle" TargetType="Label" BasedOn="{StaticResource Body}">
            <Setter Property="VerticalOptions" Value="Center" />
            <Setter Property="LineBreakMode" Value="TailTruncation" />
        </Style>
    </Shell.Resources>

    <Shell.FlyoutContentTemplate>
        <DataTemplate x:DataType="vm:AppShellViewModel">
            <ScrollView>
                <VerticalStackLayout Spacing="0" Padding="0,8">

                    <Border StrokeThickness="0" StrokeShape="RoundRectangle 6" Margin="10,2,12,6" BackgroundColor="Transparent">
                        <Border.Triggers>
                            <DataTrigger TargetType="Border" Binding="{Binding IsDashboardActive}" Value="True">
                                <Setter Property="BackgroundColor" Value="{AppThemeBinding Light={StaticResource Secondary}, Dark={StaticResource SubtleFillDark}}" />
                            </DataTrigger>
                        </Border.Triggers>
                        <Grid ColumnDefinitions="4,Auto,*" ColumnSpacing="12" Padding="0,10,8,10">
                            <BoxView Grid.Column="0" WidthRequest="4" Color="Transparent">
                                <BoxView.Triggers>
                                    <DataTrigger TargetType="BoxView" Binding="{Binding IsDashboardActive}" Value="True">
                                        <Setter Property="Color" Value="{AppThemeBinding Light={StaticResource AccentLight}, Dark={StaticResource AccentDark}}" />
                                    </DataTrigger>
                                </BoxView.Triggers>
                            </BoxView>
                            <Label Grid.Column="1" Text="&#xE80F;" Style="{StaticResource FlyoutRowIconStyle}" />
                            <Label Grid.Column="2" Text="Dashboard" Style="{StaticResource FlyoutRowTextStyle}" />
                            <Button Grid.ColumnSpan="3" Text="Dashboard" Style="{StaticResource FlyoutRowButtonStyle}"
                                    Command="{Binding NavigateCommand}" CommandParameter="//dashboard" />
                        </Grid>
                    </Border>

                    <Border StrokeThickness="0" StrokeShape="RoundRectangle 6" Margin="8,6,8,2" BackgroundColor="Transparent">
                        <Border.Triggers>
                            <DataTrigger TargetType="Border" Binding="{Binding IsWorkspaceExpanded}" Value="True">
                                <Setter Property="BackgroundColor" Value="{AppThemeBinding Light={StaticResource Secondary}, Dark={StaticResource SubtleFillDark}}" />
                            </DataTrigger>
                        </Border.Triggers>
                        <Grid ColumnDefinitions="4,Auto,*,Auto" ColumnSpacing="10" Padding="0,10,12,10">
                            <BoxView Grid.Column="0" WidthRequest="4" Color="Transparent">
                                <BoxView.Triggers>
                                    <DataTrigger TargetType="BoxView" Binding="{Binding IsWorkspaceActive}" Value="True">
                                        <Setter Property="Color" Value="{AppThemeBinding Light={StaticResource AccentLight}, Dark={StaticResource AccentDark}}" />
                                    </DataTrigger>
                                </BoxView.Triggers>
                            </BoxView>
                            <Label Grid.Column="1" Text="&#xE8F1;" Style="{StaticResource FlyoutRowIconStyle}" />
                            <Label Grid.Column="2" Text="Workspace" Style="{StaticResource FlyoutSectionTextStyle}" />
                            <Label Grid.Column="3" Text="{Binding WorkspaceChevron}" Style="{StaticResource FlyoutChevronStyle}" />
                            <Button Grid.ColumnSpan="4" Text="Workspace" Style="{StaticResource FlyoutRowButtonStyle}"
                                    Command="{Binding ToggleSectionCommand}" CommandParameter="Workspace" />
                        </Grid>
                    </Border>
                    <VerticalStackLayout IsVisible="{Binding IsWorkspaceExpanded}">
                        <Border StrokeThickness="0" StrokeShape="RoundRectangle 6" Margin="22,2,12,2" BackgroundColor="Transparent">
                            <Border.Triggers>
                                <DataTrigger TargetType="Border" Binding="{Binding IsAccessActive}" Value="True">
                                    <Setter Property="BackgroundColor" Value="{AppThemeBinding Light={StaticResource Secondary}, Dark={StaticResource SubtleFillDark}}" />
                                </DataTrigger>
                            </Border.Triggers>
                            <Grid ColumnDefinitions="4,Auto,*" ColumnSpacing="12" Padding="0,9,8,9">
                                <BoxView Grid.Column="0" WidthRequest="4" Color="Transparent" />
                                <Label Grid.Column="1" Text="&#xE72E;" Style="{StaticResource FlyoutRowIconStyle}" />
                                <Label Grid.Column="2" Text="Access" Style="{StaticResource FlyoutRowTextStyle}" />
                                <Button Grid.ColumnSpan="3" Text="Access" Style="{StaticResource FlyoutRowButtonStyle}"
                                        Command="{Binding NavigateCommand}" CommandParameter="//access" />
                            </Grid>
                        </Border>
                    </VerticalStackLayout>

                    <VerticalStackLayout IsVisible="{Binding CanManageUsers}">
                        <Border StrokeThickness="0" StrokeShape="RoundRectangle 6" Margin="8,6,8,2" BackgroundColor="Transparent">
                            <Border.Triggers>
                                <DataTrigger TargetType="Border" Binding="{Binding IsGovernanceExpanded}" Value="True">
                                    <Setter Property="BackgroundColor" Value="{AppThemeBinding Light={StaticResource Secondary}, Dark={StaticResource SubtleFillDark}}" />
                                </DataTrigger>
                            </Border.Triggers>
                            <Grid ColumnDefinitions="4,Auto,*,Auto" ColumnSpacing="10" Padding="0,10,12,10">
                                <BoxView Grid.Column="0" WidthRequest="4" Color="Transparent">
                                    <BoxView.Triggers>
                                        <DataTrigger TargetType="BoxView" Binding="{Binding IsGovernanceActive}" Value="True">
                                            <Setter Property="Color" Value="{AppThemeBinding Light={StaticResource AccentLight}, Dark={StaticResource AccentDark}}" />
                                        </DataTrigger>
                                    </BoxView.Triggers>
                                </BoxView>
                                <Label Grid.Column="1" Text="&#xE716;" Style="{StaticResource FlyoutRowIconStyle}" />
                                <Label Grid.Column="2" Text="Governance" Style="{StaticResource FlyoutSectionTextStyle}" />
                                <Label Grid.Column="3" Text="{Binding GovernanceChevron}" Style="{StaticResource FlyoutChevronStyle}" />
                                <Button Grid.ColumnSpan="4" Text="Governance" Style="{StaticResource FlyoutRowButtonStyle}"
                                        Command="{Binding ToggleSectionCommand}" CommandParameter="Governance" />
                            </Grid>
                        </Border>
                        <VerticalStackLayout IsVisible="{Binding IsGovernanceExpanded}">
                            <Border StrokeThickness="0" StrokeShape="RoundRectangle 6" Margin="22,2,12,2" BackgroundColor="Transparent">
                                <Border.Triggers>
                                    <DataTrigger TargetType="Border" Binding="{Binding IsUsersActive}" Value="True">
                                        <Setter Property="BackgroundColor" Value="{AppThemeBinding Light={StaticResource Secondary}, Dark={StaticResource SubtleFillDark}}" />
                                    </DataTrigger>
                                </Border.Triggers>
                                <Grid ColumnDefinitions="4,Auto,*" ColumnSpacing="12" Padding="0,9,8,9">
                                    <BoxView Grid.Column="0" WidthRequest="4" Color="Transparent" />
                                    <Label Grid.Column="1" Text="&#xE716;" Style="{StaticResource FlyoutRowIconStyle}" />
                                    <Label Grid.Column="2" Text="Users" Style="{StaticResource FlyoutRowTextStyle}" />
                                    <Button Grid.ColumnSpan="3" Text="Users" Style="{StaticResource FlyoutRowButtonStyle}"
                                            Command="{Binding NavigateCommand}" CommandParameter="//users" />
                                </Grid>
                            </Border>
                            <Border StrokeThickness="0" StrokeShape="RoundRectangle 6" Margin="22,2,12,2" BackgroundColor="Transparent">
                                <Border.Triggers>
                                    <DataTrigger TargetType="Border" Binding="{Binding IsCustomersActive}" Value="True">
                                        <Setter Property="BackgroundColor" Value="{AppThemeBinding Light={StaticResource Secondary}, Dark={StaticResource SubtleFillDark}}" />
                                    </DataTrigger>
                                </Border.Triggers>
                                <Grid ColumnDefinitions="4,Auto,*" ColumnSpacing="12" Padding="0,9,8,9">
                                    <BoxView Grid.Column="0" WidthRequest="4" Color="Transparent" />
                                    <Label Grid.Column="1" Text="&#xE77B;" Style="{StaticResource FlyoutRowIconStyle}" />
                                    <Label Grid.Column="2" Text="Customers" Style="{StaticResource FlyoutRowTextStyle}" />
                                    <Button Grid.ColumnSpan="3" Text="Customers" Style="{StaticResource FlyoutRowButtonStyle}"
                                            Command="{Binding NavigateCommand}" CommandParameter="//customers" />
                                </Grid>
                            </Border>
                        </VerticalStackLayout>
                    </VerticalStackLayout>

                    <VerticalStackLayout IsVisible="{Binding CanManageInfrastructure}">
                        <Border StrokeThickness="0" StrokeShape="RoundRectangle 6" Margin="8,6,8,2" BackgroundColor="Transparent">
                            <Border.Triggers>
                                <DataTrigger TargetType="Border" Binding="{Binding IsInfrastructureExpanded}" Value="True">
                                    <Setter Property="BackgroundColor" Value="{AppThemeBinding Light={StaticResource Secondary}, Dark={StaticResource SubtleFillDark}}" />
                                </DataTrigger>
                            </Border.Triggers>
                            <Grid ColumnDefinitions="4,Auto,*,Auto" ColumnSpacing="10" Padding="0,10,12,10">
                                <BoxView Grid.Column="0" WidthRequest="4" Color="Transparent">
                                    <BoxView.Triggers>
                                        <DataTrigger TargetType="BoxView" Binding="{Binding IsInfrastructureActive}" Value="True">
                                            <Setter Property="Color" Value="{AppThemeBinding Light={StaticResource AccentLight}, Dark={StaticResource AccentDark}}" />
                                        </DataTrigger>
                                    </BoxView.Triggers>
                                </BoxView>
                                <Label Grid.Column="1" Text="&#xE7F4;" Style="{StaticResource FlyoutRowIconStyle}" />
                                <Label Grid.Column="2" Text="Infrastructure" Style="{StaticResource FlyoutSectionTextStyle}" />
                                <Label Grid.Column="3" Text="{Binding InfrastructureChevron}" Style="{StaticResource FlyoutChevronStyle}" />
                                <Button Grid.ColumnSpan="4" Text="Infrastructure" Style="{StaticResource FlyoutRowButtonStyle}"
                                        Command="{Binding ToggleSectionCommand}" CommandParameter="Infrastructure" />
                            </Grid>
                        </Border>
                        <VerticalStackLayout IsVisible="{Binding IsInfrastructureExpanded}">
                            <Border StrokeThickness="0" StrokeShape="RoundRectangle 6" Margin="22,2,12,2" BackgroundColor="Transparent">
                                <Border.Triggers>
                                    <DataTrigger TargetType="Border" Binding="{Binding IsServersActive}" Value="True">
                                        <Setter Property="BackgroundColor" Value="{AppThemeBinding Light={StaticResource Secondary}, Dark={StaticResource SubtleFillDark}}" />
                                    </DataTrigger>
                                </Border.Triggers>
                                <Grid ColumnDefinitions="4,Auto,*" ColumnSpacing="12" Padding="0,9,8,9">
                                    <BoxView Grid.Column="0" WidthRequest="4" Color="Transparent" />
                                    <Label Grid.Column="1" Text="&#xE7F4;" Style="{StaticResource FlyoutRowIconStyle}" />
                                    <Label Grid.Column="2" Text="Servers" Style="{StaticResource FlyoutRowTextStyle}" />
                                    <Button Grid.ColumnSpan="3" Text="Servers" Style="{StaticResource FlyoutRowButtonStyle}"
                                            Command="{Binding NavigateCommand}" CommandParameter="//servers" />
                                </Grid>
                            </Border>
                        </VerticalStackLayout>
                    </VerticalStackLayout>

                    <VerticalStackLayout IsVisible="{Binding CanSeeApplications}">
                        <Border StrokeThickness="0" StrokeShape="RoundRectangle 6" Margin="8,6,8,2" BackgroundColor="Transparent">
                            <Border.Triggers>
                                <DataTrigger TargetType="Border" Binding="{Binding IsApplicationsExpanded}" Value="True">
                                    <Setter Property="BackgroundColor" Value="{AppThemeBinding Light={StaticResource Secondary}, Dark={StaticResource SubtleFillDark}}" />
                                </DataTrigger>
                            </Border.Triggers>
                            <Grid ColumnDefinitions="4,Auto,*,Auto" ColumnSpacing="10" Padding="0,10,12,10">
                                <BoxView Grid.Column="0" WidthRequest="4" Color="Transparent">
                                    <BoxView.Triggers>
                                        <DataTrigger TargetType="BoxView" Binding="{Binding IsApplicationsActive}" Value="True">
                                            <Setter Property="Color" Value="{AppThemeBinding Light={StaticResource AccentLight}, Dark={StaticResource AccentDark}}" />
                                        </DataTrigger>
                                    </BoxView.Triggers>
                                </BoxView>
                                <Label Grid.Column="1" Text="&#xECAA;" Style="{StaticResource FlyoutRowIconStyle}" />
                                <Label Grid.Column="2" Text="Applications" Style="{StaticResource FlyoutSectionTextStyle}" />
                                <Label Grid.Column="3" Text="{Binding ApplicationsChevron}" Style="{StaticResource FlyoutChevronStyle}" />
                                <Button Grid.ColumnSpan="4" Text="Applications" Style="{StaticResource FlyoutRowButtonStyle}"
                                        Command="{Binding ToggleSectionCommand}" CommandParameter="Applications" />
                            </Grid>
                        </Border>
                        <VerticalStackLayout IsVisible="{Binding IsApplicationsExpanded}">
                            <Border StrokeThickness="0" StrokeShape="RoundRectangle 6" Margin="22,2,12,2" BackgroundColor="Transparent">
                                <Border.Triggers>
                                    <DataTrigger TargetType="Border" Binding="{Binding IsApplicationsInventoryActive}" Value="True">
                                        <Setter Property="BackgroundColor" Value="{AppThemeBinding Light={StaticResource Secondary}, Dark={StaticResource SubtleFillDark}}" />
                                    </DataTrigger>
                                </Border.Triggers>
                                <Grid ColumnDefinitions="4,Auto,*" ColumnSpacing="12" Padding="0,9,8,9">
                                    <BoxView Grid.Column="0" WidthRequest="4" Color="Transparent" />
                                    <Label Grid.Column="1" Text="&#xECAA;" Style="{StaticResource FlyoutRowIconStyle}" />
                                    <Label Grid.Column="2" Text="Inventory" Style="{StaticResource FlyoutRowTextStyle}" />
                                    <Button Grid.ColumnSpan="3" Text="Applications inventory" Style="{StaticResource FlyoutRowButtonStyle}"
                                            Command="{Binding NavigateCommand}" CommandParameter="//applications" />
                                </Grid>
                            </Border>
                            <Border StrokeThickness="0" StrokeShape="RoundRectangle 6" Margin="22,2,12,2" BackgroundColor="Transparent">
                                <Border.Triggers>
                                    <DataTrigger TargetType="Border" Binding="{Binding IsExtractorGuideActive}" Value="True">
                                        <Setter Property="BackgroundColor" Value="{AppThemeBinding Light={StaticResource Secondary}, Dark={StaticResource SubtleFillDark}}" />
                                    </DataTrigger>
                                </Border.Triggers>
                                <Grid ColumnDefinitions="4,Auto,*" ColumnSpacing="12" Padding="0,9,8,9">
                                    <BoxView Grid.Column="0" WidthRequest="4" Color="Transparent" />
                                    <Label Grid.Column="1" Text="&#xE736;" Style="{StaticResource FlyoutRowIconStyle}" />
                                    <Label Grid.Column="2" Text="Extractor guide" Style="{StaticResource FlyoutRowTextStyle}" />
                                    <Button Grid.ColumnSpan="3" Text="Extractor guide" Style="{StaticResource FlyoutRowButtonStyle}"
                                            Command="{Binding NavigateCommand}" CommandParameter="//extractor-guide" />
                                </Grid>
                            </Border>
                        </VerticalStackLayout>
                    </VerticalStackLayout>

                    <VerticalStackLayout IsVisible="{Binding IsDevelopment}">
                        <Border StrokeThickness="0" StrokeShape="RoundRectangle 6" Margin="8,6,8,2" BackgroundColor="Transparent">
                            <Border.Triggers>
                                <DataTrigger TargetType="Border" Binding="{Binding IsDevelopmentExpanded}" Value="True">
                                    <Setter Property="BackgroundColor" Value="{AppThemeBinding Light={StaticResource Secondary}, Dark={StaticResource SubtleFillDark}}" />
                                </DataTrigger>
                            </Border.Triggers>
                            <Grid ColumnDefinitions="4,Auto,*,Auto" ColumnSpacing="10" Padding="0,10,12,10">
                                <BoxView Grid.Column="0" WidthRequest="4" Color="Transparent">
                                    <BoxView.Triggers>
                                        <DataTrigger TargetType="BoxView" Binding="{Binding IsDevelopmentActive}" Value="True">
                                            <Setter Property="Color" Value="{AppThemeBinding Light={StaticResource AccentLight}, Dark={StaticResource AccentDark}}" />
                                        </DataTrigger>
                                    </BoxView.Triggers>
                                </BoxView>
                                <Label Grid.Column="1" Text="&#xECAD;" Style="{StaticResource FlyoutRowIconStyle}" />
                                <Label Grid.Column="2" Text="Development" Style="{StaticResource FlyoutSectionTextStyle}" />
                                <Label Grid.Column="3" Text="{Binding DevelopmentChevron}" Style="{StaticResource FlyoutChevronStyle}" />
                                <Button Grid.ColumnSpan="4" Text="Development" Style="{StaticResource FlyoutRowButtonStyle}"
                                        Command="{Binding ToggleSectionCommand}" CommandParameter="Development" />
                            </Grid>
                        </Border>
                        <VerticalStackLayout IsVisible="{Binding IsDevelopmentExpanded}">
                            <Border StrokeThickness="0" StrokeShape="RoundRectangle 6" Margin="22,2,12,2" BackgroundColor="Transparent">
                                <Border.Triggers>
                                    <DataTrigger TargetType="Border" Binding="{Binding IsComponentsActive}" Value="True">
                                        <Setter Property="BackgroundColor" Value="{AppThemeBinding Light={StaticResource Secondary}, Dark={StaticResource SubtleFillDark}}" />
                                    </DataTrigger>
                                </Border.Triggers>
                                <Grid ColumnDefinitions="4,Auto,*" ColumnSpacing="12" Padding="0,9,8,9">
                                    <BoxView Grid.Column="0" WidthRequest="4" Color="Transparent" />
                                    <Label Grid.Column="1" Text="&#xECAD;" Style="{StaticResource FlyoutRowIconStyle}" />
                                    <Label Grid.Column="2" Text="Components" Style="{StaticResource FlyoutRowTextStyle}" />
                                    <Button Grid.ColumnSpan="3" Text="Components" Style="{StaticResource FlyoutRowButtonStyle}"
                                            Command="{Binding NavigateCommand}" CommandParameter="//components" />
                                </Grid>
                            </Border>
                        </VerticalStackLayout>
                    </VerticalStackLayout>

                </VerticalStackLayout>
            </ScrollView>
        </DataTemplate>
    </Shell.FlyoutContentTemplate>

    <Shell.FlyoutFooter>
        <Border StrokeThickness="0" StrokeShape="RoundRectangle 6" Margin="10,4,12,10" BackgroundColor="Transparent">
            <Border.Triggers>
                <DataTrigger TargetType="Border" Binding="{Binding IsSystemSettingsActive}" Value="True">
                    <Setter Property="BackgroundColor" Value="{AppThemeBinding Light={StaticResource Secondary}, Dark={StaticResource SubtleFillDark}}" />
                </DataTrigger>
            </Border.Triggers>
            <Grid ColumnDefinitions="4,Auto,*" ColumnSpacing="12" Padding="0,10,8,10">
                <BoxView Grid.Column="0" WidthRequest="4" Color="Transparent">
                    <BoxView.Triggers>
                        <DataTrigger TargetType="BoxView" Binding="{Binding IsSystemSettingsActive}" Value="True">
                            <Setter Property="Color" Value="{AppThemeBinding Light={StaticResource AccentLight}, Dark={StaticResource AccentDark}}" />
                        </DataTrigger>
                    </BoxView.Triggers>
                </BoxView>
                <Label Grid.Column="1" Text="&#xE713;" Style="{StaticResource FlyoutRowIconStyle}" />
                <Label Grid.Column="2" Text="System settings" Style="{StaticResource FlyoutRowTextStyle}" />
                <Button Grid.ColumnSpan="3" Text="System settings" Style="{StaticResource FlyoutRowButtonStyle}"
                        Command="{Binding NavigateCommand}" CommandParameter="//system-settings" />
            </Grid>
        </Border>
    </Shell.FlyoutFooter>

    <ShellContent
        x:Name="StartupContent"
        Route="startup"
        FlyoutItemIsVisible="False"
        Shell.FlyoutBehavior="Disabled"
        Shell.NavBarIsVisible="False"
        ContentTemplate="{DataTemplate views:StartupPage}" />

    <ShellContent
        x:Name="LoginContent"
        Route="login"
        FlyoutItemIsVisible="False"
        Shell.FlyoutBehavior="Disabled"
        Shell.NavBarIsVisible="False"
        ContentTemplate="{DataTemplate views:LoginPage}" />

    <ShellContent
        Route="first-login"
        FlyoutItemIsVisible="False"
        Shell.FlyoutBehavior="Disabled"
        Shell.NavBarIsVisible="False"
        ContentTemplate="{DataTemplate views:FirstLoginPasswordPage}" />

    <ShellContent
        Route="accept-invitation"
        FlyoutItemIsVisible="False"
        Shell.FlyoutBehavior="Disabled"
        Shell.NavBarIsVisible="False"
        ContentTemplate="{DataTemplate views:AcceptInvitationPage}" />

    <ShellContent
        Route="setup"
        FlyoutItemIsVisible="False"
        Shell.FlyoutBehavior="Disabled"
        Shell.NavBarIsVisible="False"
        ContentTemplate="{DataTemplate views:SetupWizardPage}" />

    <FlyoutItem Title="Users" Route="users" FlyoutItemIsVisible="False">
        <ShellContent Title="Users" ContentTemplate="{DataTemplate views:UsersPage}" />
    </FlyoutItem>
    <FlyoutItem Title="Customers" Route="customers" FlyoutItemIsVisible="False">
        <ShellContent Title="Customers" ContentTemplate="{DataTemplate views:CustomersPage}" />
    </FlyoutItem>
    <FlyoutItem Title="Servers" Route="servers" FlyoutItemIsVisible="False">
        <ShellContent Title="Servers" ContentTemplate="{DataTemplate views:ServersPage}" />
    </FlyoutItem>
    <FlyoutItem Title="Profile" Route="profile" FlyoutItemIsVisible="False">
        <ShellContent Title="Profile" ContentTemplate="{DataTemplate views:ProfilePage}" />
    </FlyoutItem>
    <FlyoutItem Title="System settings" Route="system-settings" FlyoutItemIsVisible="False">
        <ShellContent Title="System settings" ContentTemplate="{DataTemplate views:SystemSettingsPage}" />
    </FlyoutItem>
    <FlyoutItem Title="Dashboard" Route="dashboard" FlyoutItemIsVisible="False">
        <ShellContent Title="Dashboard" ContentTemplate="{DataTemplate views:DashboardPage}" />
    </FlyoutItem>
    <FlyoutItem Title="Access" Route="access" FlyoutItemIsVisible="False">
        <ShellContent Title="Access" ContentTemplate="{DataTemplate views:AccessPage}" />
    </FlyoutItem>
    <FlyoutItem Title="Components" Route="components" FlyoutItemIsVisible="False">
        <ShellContent Title="Components" ContentTemplate="{DataTemplate views:ComponentsPage}" />
    </FlyoutItem>
    <FlyoutItem Title="Applications" Route="applications" FlyoutItemIsVisible="False">
        <ShellContent Title="Applications" ContentTemplate="{DataTemplate views:ApplicationsPage}" />
    </FlyoutItem>
    <FlyoutItem Title="Extractor guide" Route="extractor-guide" FlyoutItemIsVisible="False">
        <ShellContent Title="Extractor guide" ContentTemplate="{DataTemplate views:ExtractorGuidePage}" />
    </FlyoutItem>

</Shell>
